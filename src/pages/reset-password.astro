---
// src/pages/reset-password.astro
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Reset Password — VerseSEO"
  description="Set a new password for your VerseSEO account."
  robots="noindex, nofollow"
>
  <main class="min-h-screen flex flex-col">
    <header class="w-full">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-lg p-1">
          <img src="/brand/logo-mark-new.png" alt="VerseSEO icon" class="w-9 h-9 rounded-xl object-cover" />
          <span class="font-extrabold text-xl tracking-tight text-slate-900">VerseSEO</span>
        </a>
        <a href="/" class="text-sm font-medium text-slate-600 hover:text-slate-900 hover:underline">← Back to home</a>
      </div>
    </header>

    <div class="flex-1 flex items-center justify-center px-4 sm:px-6 py-12 sm:py-16">
      <div class="w-full max-w-md">
        <div class="bg-white rounded-3xl border border-slate-200/90 shadow-2xl shadow-slate-900/10 p-8 sm:p-10">
          <a href="/" class="inline-flex items-center gap-2.5 mb-8 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-lg">
            <img src="/brand/logo-mark-new.png" alt="VerseSEO icon" class="w-9 h-9 rounded-xl object-cover" />
            <span class="font-extrabold text-xl tracking-tight text-slate-900">VerseSEO</span>
          </a>

          <div id="reset-form-view">
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Set new password</h1>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">
              Enter your new password below.
            </p>

            <div id="reset-error" class="hidden mt-4 px-3 py-2.5 rounded-lg bg-rose-50 border border-rose-200 text-sm text-rose-700"></div>

            <form id="reset-form" class="mt-6 space-y-4" novalidate>
              <div>
                <label for="reset-password" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">New password <span class="normal-case font-medium text-slate-400">(8+ characters)</span></label>
                <input
                  type="password"
                  id="reset-password"
                  name="password"
                  autocomplete="new-password"
                  minlength="8"
                  maxlength="200"
                  required
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"
                  placeholder="Create a new password"
                />
              </div>

              <div>
                <label for="reset-confirm" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Confirm password</label>
                <input
                  type="password"
                  id="reset-confirm"
                  name="confirm"
                  autocomplete="new-password"
                  required
                  class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"
                  placeholder="Repeat your password"
                />
              </div>

              <button
                type="submit"
                id="reset-submit"
                class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 disabled:opacity-60 disabled:cursor-wait text-white font-semibold text-sm rounded-xl shadow-md shadow-blue-600/25 transition-all duration-200 cursor-pointer"
              >
                <span id="reset-submit-label">Reset password</span>
              </button>
            </form>

            <div class="mt-6 text-center text-sm text-slate-600">
              <a href="/login" class="font-semibold text-blue-600 hover:text-blue-700 hover:underline">← Back to login</a>
            </div>
          </div>

          <div id="reset-success" class="hidden text-center py-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-emerald-100 mb-4">
              <span class="text-3xl text-emerald-600">✓</span>
            </div>
            <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight mb-2">Password reset!</h1>
            <p class="text-sm text-slate-600 mb-6">Your password has been updated. Please log in with your new password.</p>
            <a href="/login" class="inline-flex items-center justify-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-md shadow-blue-600/25 transition-all">
              Go to Login
            </a>
          </div>

          <div id="reset-invalid" class="hidden text-center py-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-rose-100 mb-4">
              <span class="text-3xl text-rose-600">✕</span>
            </div>
            <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight mb-2">Invalid link</h1>
            <p class="text-sm text-slate-600 mb-6">This password reset link is invalid or has expired.</p>
            <a href="/forgot-password" class="inline-flex items-center justify-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-md shadow-blue-600/25 transition-all">
              Request a new link
            </a>
          </div>
        </div>
      </div>
    </div>

    <footer class="text-center py-8 text-xs text-slate-400">
      &copy; VerseSEO · Powered by real crawl data, not guesses.
    </footer>
  </main>
</Layout>

<script>
  import { API_BASE } from '../lib/api-config';
  const params = new URLSearchParams(window.location.search);
  const token = params.get('token');

  const formView = document.getElementById('reset-form-view');
  const successView = document.getElementById('reset-success');
  const invalidView = document.getElementById('reset-invalid');
  const form = document.getElementById('reset-form');
  const passwordInput = document.getElementById('reset-password') as HTMLInputElement | null;
  const confirmInput = document.getElementById('reset-confirm') as HTMLInputElement | null;
  const submitBtn = document.getElementById('reset-submit') as HTMLButtonElement | null;
  const submitLabel = document.getElementById('reset-submit-label');
  const errorBanner = document.getElementById('reset-error');

  if (!token) {
    formView?.classList.add('hidden');
    invalidView?.classList.remove('hidden');
  }

  function showBanner(el: HTMLElement | null, message: string) {
    if (!el) return;
    el.textContent = message;
    el.classList.remove('hidden');
  }

  function hideBanner(el: HTMLElement | null) {
    if (!el) return;
    el.classList.add('hidden');
  }

  function setLoading(loading: boolean) {
    if (!submitBtn || !submitLabel) return;
    submitBtn.disabled = loading;
    submitLabel.textContent = loading ? 'Resetting...' : 'Reset password';
  }

  async function submit(event: Event) {
    event.preventDefault();
    hideBanner(errorBanner);

    const password = passwordInput?.value ?? '';
    if (password.length < 8) {
      showBanner(errorBanner, 'Password must be at least 8 characters.');
      return;
    }
    if (confirmInput && password !== confirmInput.value) {
      showBanner(errorBanner, 'Passwords do not match.');
      return;
    }

    setLoading(true);
    try {
      const res = await fetch(`${API_BASE}/api/auth/reset-password`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token, password }),
      });

      setLoading(false);

      if (res.ok) {
        formView?.classList.add('hidden');
        successView?.classList.remove('hidden');
      } else {
        const body = await res.json().catch(() => null);
        formView?.classList.add('hidden');
        const msg = body?.error?.message ?? 'This password reset link is invalid or has expired.';
        const msgEl = document.getElementById('reset-invalid')?.querySelector('p');
        if (msgEl) msgEl.textContent = msg;
        invalidView?.classList.remove('hidden');
      }
    } catch {
      setLoading(false);
      showBanner(errorBanner, 'Could not reach the server. Please try again.');
    }
  }

  form?.addEventListener('submit', submit);
</script>

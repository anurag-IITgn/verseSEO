---
// src/pages/app.astro — authenticated SaaS dashboard
import Layout from '../layouts/Layout.astro';
import LiveAuditSimulator from '../components/LiveAuditSimulator.astro';
---

<Layout
  title="Dashboard — Foundable"
  description="Your Foundable dashboard: projects, audits, and visibility tracking."
  canonical="https://foundable.io/app"
  ogImage="/og-image.png"
>
  <!-- App Header -->
  <header class="sticky top-0 z-50 w-full border-b bg-white/85 backdrop-blur-xl border-slate-200/70 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16 gap-3">
        <div class="flex items-center gap-6">
          <a href="/" class="flex items-center gap-2.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-lg p-1">
            <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-blue-700 via-indigo-600 to-violet-500 flex items-center justify-center shadow-md shadow-blue-500/20 text-white font-bold text-lg">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M12 3v18"></path>
                <path d="M3 12h18"></path>
                <circle cx="12" cy="12" r="4" fill="currentColor" fill-opacity="0.25"></circle>
              </svg>
            </div>
            <span class="font-extrabold text-lg tracking-tight text-slate-900 hidden sm:inline">Foundable</span>
          </a>

          <nav class="flex items-center gap-1 text-sm font-medium text-slate-600" aria-label="App Navigation">
            <button type="button" data-app-nav="dashboard" class="app-nav-link px-3 py-2 rounded-lg text-slate-900 font-semibold hover:bg-slate-100 transition-colors cursor-pointer">
              Dashboard
            </button>
            <button type="button" data-app-nav="projects" class="app-nav-link px-3 py-2 rounded-lg hover:bg-slate-100 transition-colors cursor-pointer">
              Projects
            </button>
            <button type="button" data-app-nav="settings" class="app-nav-link px-3 py-2 rounded-lg hover:bg-slate-100 transition-colors cursor-pointer">
              Settings
            </button>
          </nav>
        </div>

        <div class="flex items-center gap-3">
          <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-100 border border-slate-200 text-xs text-slate-600">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span id="app-user-email" class="font-semibold text-slate-800 max-w-52 truncate">…</span>
          </div>
          <button
            type="button"
            id="app-logout-btn"
            class="px-3.5 py-2 text-xs font-semibold text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-100 hover:border-slate-400 transition-colors cursor-pointer"
          >
            Log out
          </button>
        </div>
      </div>
    </div>
  </header>

  <main class="flex-grow bg-[#FAF9F5]">

    <!-- View: Dashboard / Projects -->
    <div id="view-dashboard" class="py-10 sm:py-14">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
          <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Your projects</h1>
            <p class="mt-1 text-sm text-slate-500 max-w-xl">
              Create a project to run technical SEO audits, discover search and Reddit opportunities, and track AI citations over time.
            </p>
          </div>
          <button
            type="button"
            id="app-new-project-btn"
            class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-xl shadow-md shadow-blue-600/20 transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
            New project
          </button>
        </div>

        <!-- Create project form -->
        <form id="app-create-form" class="hidden mb-8 p-5 sm:p-6 bg-white rounded-2xl border border-slate-200 shadow-sm space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-sm font-bold text-slate-900">Create a new project</h2>
            <button type="button" id="app-create-cancel" class="text-xs font-semibold text-slate-500 hover:text-slate-700 cursor-pointer">Cancel</button>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="app-project-name" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Project name <span class="font-medium normal-case text-slate-400">(optional)</span></label>
              <input
                type="text"
                id="app-project-name"
                placeholder="e.g. Marketing site"
                class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"
              />
            </div>
            <div>
              <label for="app-project-url" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Website URL</label>
              <input
                type="text"
                id="app-project-url"
                required
                placeholder="yourcompany.com"
                class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"
              />
            </div>
          </div>
          <div id="app-create-error" class="hidden px-3 py-2.5 rounded-lg bg-rose-50 border border-rose-200 text-sm text-rose-700"></div>
          <div class="flex justify-end gap-2">
            <button type="submit" id="app-create-submit" class="px-5 py-2.5 bg-slate-900 hover:bg-blue-700 text-white text-sm font-semibold rounded-xl transition-colors cursor-pointer">
              Create project
            </button>
          </div>
        </form>

        <div id="app-projects-error" class="hidden mb-6 px-4 py-3 rounded-xl bg-rose-50 border border-rose-200 text-sm text-rose-700"></div>

        <!-- Project list loading skeleton -->
        <div id="app-projects-loading" class="hidden grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 mb-6">
          <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 animate-pulse">
            <div class="h-4 w-3/4 bg-slate-200 rounded mb-3"></div>
            <div class="h-3 w-1/2 bg-slate-100 rounded mb-4"></div>
            <div class="h-8 w-24 bg-slate-100 rounded mb-4"></div>
            <div class="flex gap-2">
              <div class="h-8 flex-1 bg-slate-100 rounded-lg"></div>
              <div class="h-8 flex-1 bg-slate-100 rounded-lg"></div>
            </div>
          </div>
          <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 animate-pulse">
            <div class="h-4 w-2/3 bg-slate-200 rounded mb-3"></div>
            <div class="h-3 w-1/2 bg-slate-100 rounded mb-4"></div>
            <div class="h-8 w-24 bg-slate-100 rounded mb-4"></div>
            <div class="flex gap-2">
              <div class="h-8 flex-1 bg-slate-100 rounded-lg"></div>
              <div class="h-8 flex-1 bg-slate-100 rounded-lg"></div>
            </div>
          </div>
          <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 animate-pulse">
            <div class="h-4 w-3/4 bg-slate-200 rounded mb-3"></div>
            <div class="h-3 w-1/2 bg-slate-100 rounded mb-4"></div>
            <div class="h-8 w-24 bg-slate-100 rounded mb-4"></div>
            <div class="flex gap-2">
              <div class="h-8 flex-1 bg-slate-100 rounded-lg"></div>
              <div class="h-8 flex-1 bg-slate-100 rounded-lg"></div>
            </div>
          </div>
        </div>

        <!-- Project cards -->
        <div id="app-projects-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4"></div>

        <!-- Empty state -->
        <div id="app-projects-empty" class="hidden text-center py-20 px-6 border-2 border-dashed border-slate-200 rounded-3xl">
          <div class="mx-auto w-14 h-14 rounded-2xl bg-blue-50 border border-blue-200 flex items-center justify-center text-2xl mb-4">🛰️</div>
          <h2 class="text-lg font-bold text-slate-900">No projects yet</h2>
          <p class="mt-1 text-sm text-slate-500 max-w-md mx-auto">
            Add a website to run an instant technical SEO audit, uncover search and Reddit opportunities, and measure AI citations over time.
          </p>
          <button
            type="button"
            id="app-empty-new-project-btn"
            class="mt-5 inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-xl shadow-md shadow-blue-600/20 transition-colors cursor-pointer"
          >
            Analyze your first website
          </button>
        </div>
      </div>
    </div>

    <!-- View: Project detail / audit -->
    <div id="view-project" class="hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-8">
          <button
            type="button"
            id="app-back-btn"
            class="inline-flex items-center gap-2 px-3.5 py-2 text-sm font-semibold text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-100 hover:border-slate-400 transition-colors cursor-pointer"
          >
            ← Back to projects
          </button>
          <div class="text-right">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 font-mono">Current Project</span>
            <h1 id="app-project-title" class="text-xl sm:text-2xl font-black text-slate-900 font-mono">—</h1>
          </div>
        </div>
        <LiveAuditSimulator mode="app" />
      </div>
    </div>

    <!-- View: Settings -->
    <div id="view-settings" class="hidden py-10 sm:py-14">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Settings</h1>
        <p class="mt-1 text-sm text-slate-500">Manage your account.</p>

        <div class="mt-8 bg-white rounded-2xl border border-slate-200 shadow-sm divide-y divide-slate-100">
          <div class="p-5 flex items-center justify-between gap-4">
            <div>
              <div class="text-xs font-bold uppercase tracking-wider text-slate-500">Account</div>
              <div class="mt-1 text-sm text-slate-700 font-medium" id="app-settings-email">…</div>
            </div>
            <span class="px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold border border-emerald-100">Signed in</span>
          </div>
          <div class="p-5">
            <div class="text-xs font-bold uppercase tracking-wider text-slate-500">Profile & billing</div>
            <p class="mt-1 text-sm text-slate-500">
              Password reset, profile management, and billing settings are coming soon. Your sessions are protected with scrypt-hashed passwords and secure cookies.
            </p>
          </div>
          <div class="p-5 flex items-center justify-between gap-4">
            <div>
              <div class="text-xs font-bold uppercase tracking-wider text-slate-500">Sign out</div>
              <p class="mt-1 text-sm text-slate-500">End your session on this device.</p>
            </div>
            <button
              type="button"
              id="app-settings-logout-btn"
              class="px-4 py-2 text-xs font-semibold text-rose-700 bg-white border border-rose-200 rounded-lg hover:bg-rose-50 transition-colors cursor-pointer"
            >
              Log out
            </button>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Rename project modal -->
  <div id="app-rename-modal" class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="app-rename-title">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-xl border border-slate-200 p-6" data-modal-panel>
      <h2 id="app-rename-title" class="text-lg font-bold text-slate-900">Rename project</h2>
      <p class="mt-1 text-sm text-slate-500">Update the name of <span id="app-rename-domain" class="font-mono font-semibold text-slate-700"></span>.</p>
      <label for="app-rename-input" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mt-4 mb-1.5">Project name</label>
      <input
        type="text"
        id="app-rename-input"
        maxlength="255"
        class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white text-sm text-slate-900 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"
      />
      <div id="app-rename-error" class="hidden mt-3 px-3 py-2.5 rounded-lg bg-rose-50 border border-rose-200 text-sm text-rose-700"></div>
      <div class="flex justify-end gap-2 mt-5">
        <button type="button" id="app-rename-cancel" class="px-4 py-2 text-sm font-semibold text-slate-700 bg-white border border-slate-300 rounded-xl hover:bg-slate-100 transition-colors cursor-pointer">Cancel</button>
        <button type="button" id="app-rename-submit" class="px-4 py-2 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-xl transition-colors cursor-pointer">Save name</button>
      </div>
    </div>
  </div>

  <!-- Delete project modal -->
  <div id="app-delete-modal" class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="app-delete-title">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-xl border border-slate-200 p-6" data-modal-panel>
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-rose-50 border border-rose-200 flex items-center justify-center text-rose-600">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
        </div>
        <div>
          <h2 id="app-delete-title" class="text-lg font-bold text-slate-900">Delete project?</h2>
          <p class="text-xs text-slate-500 font-mono" id="app-delete-domain">—</p>
        </div>
      </div>
      <p class="mt-4 text-sm text-slate-600 leading-relaxed">
        This will permanently delete this project and <strong>all of its scans, audit results, and history</strong>. This action cannot be undone.
      </p>
      <div id="app-delete-error" class="hidden mt-3 px-3 py-2.5 rounded-lg bg-rose-50 border border-rose-200 text-sm text-rose-700"></div>
      <div class="flex justify-end gap-2 mt-5">
        <button type="button" id="app-delete-cancel" class="px-4 py-2 text-sm font-semibold text-slate-700 bg-white border border-slate-300 rounded-xl hover:bg-slate-100 transition-colors cursor-pointer">Cancel</button>
        <button type="button" id="app-delete-submit" class="px-4 py-2 text-sm font-semibold text-white bg-rose-600 hover:bg-rose-700 rounded-xl transition-colors cursor-pointer">Delete project</button>
      </div>
    </div>
  </div>

  <footer class="text-center py-8 text-xs text-slate-400">
    &copy; Foundable · Only you can see your projects and scans.
  </footer>
</Layout>

<script>
  const API_BASE = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:3000';

  function apiFetch(path: string, init: RequestInit = {}): Promise<Response> {
    const headers: Record<string, string> = { Accept: 'application/json', ...(init.headers as Record<string, string>) };
    if (typeof init.body === 'string') headers['Content-Type'] = 'application/json';
    return fetch(`${API_BASE}${path}`, { ...init, headers, credentials: 'include' });
  }

  async function backendError(res: Response): Promise<Error> {
    try {
      const body = await res.json();
      return new Error(body?.error?.message ?? `Backend request failed (${res.status})`);
    } catch {
      return new Error(`Backend request failed (${res.status})`);
    }
  }

  function escapeHtml(value: string): string {
    return String(value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function timeAgo(iso: string): string {
    const ms = Date.now() - Date.parse(iso);
    if (!Number.isFinite(ms) || ms < 0) return '';
    const days = Math.floor(ms / 86_400_000);
    if (days >= 365) return `${Math.floor(days / 365)}y ago`;
    if (days >= 30) return `${Math.floor(days / 30)}mo ago`;
    if (days >= 1) return `${days}d ago`;
    const hours = Math.floor(ms / 3_600_000);
    if (hours >= 1) return `${hours}h ago`;
    const minutes = Math.floor(ms / 60_000);
    return `${Math.max(1, minutes)}m ago`;
  }

  interface Project {
    id: string;
    name: string | null;
    websiteUrl: string;
    domain: string;
    scanCount: number;
    latestScan: {
      id: string;
      status: string;
      startedAt: string | null;
      completedAt: string | null;
      createdAt: string;
      healthScore: number | null;
      pagesCrawled: number;
      pagesDiscovered: number;
    } | null;
  }

  interface User {
    id: string;
    email: string;
  }

  const viewDashboard = document.getElementById('view-dashboard');
  const viewProject = document.getElementById('view-project');
  const viewSettings = document.getElementById('view-settings');
  const projectsGrid = document.getElementById('app-projects-grid');
  const projectsEmpty = document.getElementById('app-projects-empty');
  const projectsLoading = document.getElementById('app-projects-loading');
  const projectsError = document.getElementById('app-projects-error');
  const createForm = document.getElementById('app-create-form') as HTMLFormElement | null;
  const createError = document.getElementById('app-create-error');
  const projectNameInput = document.getElementById('app-project-name') as HTMLInputElement | null;
  const projectUrlInput = document.getElementById('app-project-url') as HTMLInputElement | null;
  const renameModal = document.getElementById('app-rename-modal');
  const renameInput = document.getElementById('app-rename-input') as HTMLInputElement | null;
  const renameError = document.getElementById('app-rename-error');
  const renameDomain = document.getElementById('app-rename-domain');
  const renameSubmit = document.getElementById('app-rename-submit');
  const deleteModal = document.getElementById('app-delete-modal');
  const deleteError = document.getElementById('app-delete-error');
  const deleteDomain = document.getElementById('app-delete-domain');
  const deleteSubmit = document.getElementById('app-delete-submit');
  const navLinks = document.querySelectorAll<HTMLButtonElement>('.app-nav-link');

  let currentUser: User | null = null;
  let projects: Project[] = [];
  let currentProject: Project | null = null;
  let renameTarget: Project | null = null;
  let deleteTarget: Project | null = null;

  function showBanner(el: HTMLElement | null, message: string) {
    if (!el) return;
    el.textContent = message;
    el.classList.remove('hidden');
  }

  function hideBanner(el: HTMLElement | null) {
    if (!el) return;
    el.classList.add('hidden');
  }

  function showView(name: 'dashboard' | 'project' | 'settings') {
    if (viewDashboard) viewDashboard.classList.toggle('hidden', name !== 'dashboard');
    if (viewProject) viewProject.classList.toggle('hidden', name !== 'project');
    if (viewSettings) viewSettings.classList.toggle('hidden', name !== 'settings');
    navLinks.forEach(link => {
      const isActive = (name === 'dashboard' || name === 'projects') && link.dataset.appNav === 'dashboard'
        || (name === 'settings' && link.dataset.appNav === 'settings');
      link.classList.toggle('text-slate-900', isActive);
      link.classList.toggle('font-semibold', isActive);
    });
  }

  const statusMeta: Record<string, { label: string; cls: string }> = {
    COMPLETED: { label: 'Completed', cls: 'bg-emerald-50 text-emerald-700 border-emerald-200' },
    RUNNING: { label: 'Running', cls: 'bg-blue-50 text-blue-700 border-blue-200' },
    PENDING: { label: 'Queued', cls: 'bg-slate-100 text-slate-600 border-slate-200' },
    FAILED: { label: 'Failed', cls: 'bg-rose-50 text-rose-700 border-rose-200' },
  };

  function renderProjects() {
    if (!projectsGrid || !projectsEmpty || !projectsLoading) return;
    projectsLoading.classList.add('hidden');
    if (projects.length === 0) {
      projectsGrid.innerHTML = '';
      projectsEmpty.classList.remove('hidden');
      return;
    }
    projectsEmpty.classList.add('hidden');
    projectsGrid.innerHTML = projects.map(renderProjectCard).join('');
  }

  function closeProjectMenus(exceptId?: string) {
    document.querySelectorAll<HTMLElement>('[data-menu]').forEach((menu) => {
      if (menu.dataset.menu !== exceptId) menu.classList.add('hidden');
    });
  }

  function renderProjectCard(p: Project): string {
    const scan = p.latestScan;
    const health = scan?.healthScore ?? null;
    const lastScanned = scan ? timeAgo(scan.completedAt ?? scan.createdAt) : 'Never';
    const status = scan?.status ?? null;
    const meta = status ? statusMeta[status] : null;
    const statusBadge = meta
      ? `<span class="inline-flex items-center px-2 py-0.5 rounded-full border text-[10px] font-bold ${meta.cls}">${meta.label}</span>`
      : `<span class="inline-flex items-center px-2 py-0.5 rounded-full border text-[10px] font-bold bg-slate-100 text-slate-500 border-slate-200">No scan</span>`;
    const scanCount = p.scanCount > 0
      ? `<span class="font-mono text-slate-400">${p.scanCount} ${p.scanCount === 1 ? 'scan' : 'scans'}</span>`
      : '';

    return `
      <div class="relative bg-white rounded-2xl border border-slate-200 shadow-sm p-5 flex flex-col gap-4 hover:shadow-md hover:border-slate-300 transition-all">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <div class="font-bold text-slate-900 truncate">${escapeHtml(p.domain)}</div>
            <div class="text-xs text-slate-400 font-mono truncate mt-0.5">${escapeHtml(p.websiteUrl)}</div>
          </div>
          <div class="flex items-start gap-2 shrink-0">
            <div class="text-right">
              <div class="text-xl font-black text-blue-700 leading-none">${health ?? '—'}</div>
              <div class="text-[9px] font-bold uppercase tracking-wider text-slate-400 mt-1">health /100</div>
            </div>
            <div class="relative">
              <button
                type="button"
                data-action="menu"
                data-id="${p.id}"
                aria-label="Project actions for ${escapeHtml(p.domain)}"
                class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100 hover:text-slate-700 border border-transparent hover:border-slate-200 transition-colors cursor-pointer"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg>
              </button>
              <div data-menu="${p.id}" class="hidden absolute right-0 top-full mt-1 w-40 bg-white border border-slate-200 rounded-xl shadow-lg z-20 py-1">
                <button type="button" data-action="rename" data-id="${p.id}" class="w-full text-left px-3.5 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors cursor-pointer">
                  Rename project
                </button>
                <button type="button" data-action="delete" data-id="${p.id}" class="w-full text-left px-3.5 py-2 text-xs font-semibold text-rose-700 hover:bg-rose-50 transition-colors cursor-pointer">
                  Delete project
                </button>
              </div>
            </div>
          </div>
        </div>
        <div class="flex items-center justify-between gap-2 text-xs text-slate-500">
          <div class="flex items-center gap-2">
            ${statusBadge}
            ${scanCount}
          </div>
          <span class="font-mono">Last scan: <span class="text-slate-700 font-semibold">${lastScanned}</span></span>
        </div>
        <div class="flex items-center gap-2 pt-1 border-t border-slate-100">
          <button type="button" data-action="open" data-id="${p.id}" class="flex-1 px-3 py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors cursor-pointer">Open audit</button>
          <button type="button" data-action="scan" data-id="${p.id}" class="flex-1 px-3 py-2 text-xs font-semibold text-slate-700 bg-white border border-slate-300 hover:bg-slate-100 rounded-lg transition-colors cursor-pointer">Run scan</button>
          <button type="button" data-action="history" data-id="${p.id}" class="px-3 py-2 text-xs font-semibold text-slate-700 bg-white border border-slate-300 hover:bg-slate-100 rounded-lg transition-colors cursor-pointer">History</button>
        </div>
      </div>
    `;
  }

  async function loadProjects() {
    if (projectsLoading) projectsLoading.classList.remove('hidden');
    try {
      const res = await apiFetch('/api/projects');
      if (!res.ok) {
        if (res.status === 401) {
          window.location.replace('/login?next=/app');
          return;
        }
        hideBanner(projectsError);
        showBanner(projectsError, (await backendError(res)).message);
        return;
      }
      hideBanner(projectsError);
      projects = (await res.json()).projects ?? [];
      renderProjects();
    } catch {
      hideBanner(projectsError);
      showBanner(projectsError, 'Could not load your projects. Is the backend running on localhost:3000?');
      if (projectsLoading) projectsLoading.classList.add('hidden');
    }
  }

  function openProject(project: Project, action: 'open' | 'scan' | 'history') {
    currentProject = project;
    const title = document.getElementById('app-project-title');
    if (title) title.textContent = project.domain;
    showView('project');
    window.scrollTo({ top: 0 });
    window.dispatchEvent(new CustomEvent('foundable:select-project', {
      detail: { id: project.id, domain: project.domain, websiteUrl: project.websiteUrl, action },
    }));
  }

  function showCreateForm(show: boolean) {
    if (!createForm) return;
    createForm.classList.toggle('hidden', !show);
    if (show) {
      hideBanner(createError);
      setTimeout(() => projectUrlInput?.focus(), 50);
    }
  }

  async function createProject(event: Event) {
    event.preventDefault();
    hideBanner(createError);
    const raw = projectUrlInput?.value.trim() ?? '';
    if (!raw) {
      showBanner(createError, 'Please enter a website URL.');
      return;
    }
    const websiteUrl = /^https?:\/\//i.test(raw) ? raw.replace(/\/+$/, '') : `https://${raw.replace(/\/+$/, '')}`;
    const name = (projectNameInput?.value ?? '').trim();

    const submitBtn = document.getElementById('app-create-submit') as HTMLButtonElement | null;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Creating...';
    }
    try {
      const res = await apiFetch('/api/projects', {
        method: 'POST',
        body: JSON.stringify({ ...(name ? { name } : {}), websiteUrl }),
      });
      if (!res.ok) {
        if (res.status === 401) {
          window.location.replace('/login?next=/app');
          return;
        }
        const err = await backendError(res);
        showBanner(createError, err.message);
        return;
      }
      const project: Project = await res.json();
      if (createForm) createForm.reset();
      showCreateForm(false);
      await loadProjects();
      openProject(project, 'open');
    } catch {
      showBanner(createError, 'Could not reach the backend. Is it running on localhost:3000?');
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Create project';
      }
    }
  }

  function openRenameModal(project: Project) {
    renameTarget = project;
    if (renameDomain) renameDomain.textContent = project.domain;
    if (renameInput) {
      renameInput.value = project.name ?? project.domain;
      renameInput.removeAttribute('disabled');
    }
    hideBanner(renameError);
    if (renameSubmit) {
      renameSubmit.disabled = false;
      renameSubmit.textContent = 'Save name';
    }
    if (renameModal) renameModal.classList.remove('hidden');
    setTimeout(() => renameInput?.focus(), 50);
  }

  function closeRenameModal() {
    if (renameModal) renameModal.classList.add('hidden');
    renameTarget = null;
  }

  async function submitRename() {
    if (!renameTarget) return;
    const name = renameInput?.value.trim() ?? '';
    if (!name) {
      showBanner(renameError, 'Please enter a project name.');
      return;
    }
    hideBanner(renameError);
    if (renameInput) renameInput.disabled = true;
    if (renameSubmit) {
      renameSubmit.disabled = true;
      renameSubmit.textContent = 'Saving...';
    }
    try {
      const res = await apiFetch(`/api/projects/${renameTarget.id}`, {
        method: 'PATCH',
        body: JSON.stringify({ name }),
      });
      if (!res.ok) {
        if (res.status === 401) {
          window.location.replace('/login?next=/app');
          return;
        }
        const err = await backendError(res);
        showBanner(renameError, err.message);
        return;
      }
      const updated: Project = await res.json();
      const idx = projects.findIndex((p) => p.id === updated.id);
      if (idx >= 0) projects[idx] = { ...projects[idx], ...updated };
      if (currentProject?.id === updated.id) currentProject = updated;
      renderProjects();
      closeRenameModal();
    } catch {
      showBanner(renameError, 'Could not reach the backend. Is it running on localhost:3000?');
    } finally {
      if (renameInput) renameInput.disabled = false;
      if (renameSubmit) {
        renameSubmit.disabled = false;
        renameSubmit.textContent = 'Save name';
      }
    }
  }

  function openDeleteModal(project: Project) {
    deleteTarget = project;
    if (deleteDomain) deleteDomain.textContent = project.domain;
    hideBanner(deleteError);
    if (deleteSubmit) {
      deleteSubmit.disabled = false;
      deleteSubmit.textContent = 'Delete project';
    }
    if (deleteModal) deleteModal.classList.remove('hidden');
  }

  function closeDeleteModal() {
    if (deleteModal) deleteModal.classList.add('hidden');
    deleteTarget = null;
  }

  async function submitDelete() {
    if (!deleteTarget) return;
    hideBanner(deleteError);
    if (deleteSubmit) {
      deleteSubmit.disabled = true;
      deleteSubmit.textContent = 'Deleting...';
    }
    try {
      const res = await apiFetch(`/api/projects/${deleteTarget.id}`, {
        method: 'DELETE',
      });
      if (!res.ok) {
        if (res.status === 401) {
          window.location.replace('/login?next=/app');
          return;
        }
        const err = await backendError(res);
        showBanner(deleteError, err.message);
        return;
      }
      const deletedId = deleteTarget.id;
      projects = projects.filter((p) => p.id !== deletedId);
      closeDeleteModal();
      renderProjects();
      if (currentProject?.id === deletedId) {
        currentProject = null;
        showView('dashboard');
        void loadProjects();
      }
    } catch {
      showBanner(deleteError, 'Could not reach the backend. Is it running on localhost:3000?');
    } finally {
      if (deleteSubmit) {
        deleteSubmit.disabled = false;
        deleteSubmit.textContent = 'Delete project';
      }
    }
  }

  async function logout() {
    try {
      await apiFetch('/api/auth/logout', { method: 'POST' });
    } catch {
      // Proceed with local redirect even if the backend is unreachable.
    }
    window.location.href = '/';
  }

  async function init() {
    const res = await apiFetch('/api/auth/me');
    if (!res.ok) {
      window.location.replace('/login?next=/app');
      return;
    }
    currentUser = (await res.json()).user;
    const emailLabel = document.getElementById('app-user-email');
    const settingsEmail = document.getElementById('app-settings-email');
    if (emailLabel && currentUser) emailLabel.textContent = currentUser.email;
    if (settingsEmail && currentUser) settingsEmail.textContent = currentUser.email;

    await loadProjects();

    const params = new URLSearchParams(window.location.search);
    const website = params.get('website');
    if (website && projectUrlInput) {
      projectUrlInput.value = website;
      showCreateForm(true);
    }
  }

  projectsGrid?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const btn = target.closest<HTMLButtonElement>('button[data-action]');
    if (!btn) return;
    const id = btn.getAttribute('data-id');
    const action = btn.getAttribute('data-action') as 'open' | 'scan' | 'history' | 'menu' | 'rename' | 'delete' | null;
    const project = projects.find((p) => p.id === id);
    if (!project || !action) return;
    if (action === 'menu') {
      const menu = document.querySelector<HTMLElement>(`[data-menu="${id}"]`);
      if (!menu) return;
      const willOpen = menu.classList.contains('hidden');
      closeProjectMenus();
      if (willOpen) menu.classList.remove('hidden');
      return;
    }
    closeProjectMenus();
    if (action === 'rename') {
      openRenameModal(project);
      return;
    }
    if (action === 'delete') {
      openDeleteModal(project);
      return;
    }
    openProject(project, action);
  });

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('button[data-action]')) return;
    closeProjectMenus();
  });

  document.getElementById('app-new-project-btn')?.addEventListener('click', () => showCreateForm(true));
  document.getElementById('app-empty-new-project-btn')?.addEventListener('click', () => showCreateForm(true));
  document.getElementById('app-create-cancel')?.addEventListener('click', () => showCreateForm(false));
  createForm?.addEventListener('submit', createProject);

  renameSubmit?.addEventListener('click', () => void submitRename());
  document.getElementById('app-rename-cancel')?.addEventListener('click', closeRenameModal);
  renameInput?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') void submitRename();
    if (event.key === 'Escape') closeRenameModal();
  });

  deleteSubmit?.addEventListener('click', () => void submitDelete());
  document.getElementById('app-delete-cancel')?.addEventListener('click', closeDeleteModal);

  [renameModal, deleteModal].forEach((modal) => {
    modal?.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).hasAttribute('data-modal-panel')) return;
      if (modal === renameModal) closeRenameModal();
      if (modal === deleteModal) closeDeleteModal();
    });
  });

  document.getElementById('app-back-btn')?.addEventListener('click', () => {
    currentProject = null;
    showView('dashboard');
    void loadProjects();
  });

  document.getElementById('app-logout-btn')?.addEventListener('click', () => void logout());
  document.getElementById('app-settings-logout-btn')?.addEventListener('click', () => void logout());

  navLinks.forEach((link) => {
    link.addEventListener('click', () => {
      const target = link.dataset.appNav;
      if (target === 'settings') {
        showView('settings');
      } else {
        showView('dashboard');
        void loadProjects();
      }
    });
  });

  window.addEventListener('foundable:scan-complete', () => {
    void loadProjects();
  });

  showView('dashboard');
  void init();
</script>
---
// src/pages/app.astro — authenticated SaaS dashboard
import Layout from '../layouts/Layout.astro';
import AppSidebar from '../components/app/AppSidebar.astro';
import ProcessingLoader from '../components/app/ProcessingLoader.astro';
---

<Layout
  title="Dashboard — Foundable"
  description="Your Foundable dashboard: projects, audits, and visibility tracking."
  canonical="https://foundable.io/app"
  ogImage="/og-image.png"
>
  <div id="sidebar-overlay" class="fixed inset-0 z-30 bg-black/50 hidden lg:hidden"></div>
  <AppSidebar />

  <div class="lg:ml-64 min-h-screen flex flex-col">
    <!-- Top bar -->
    <header class="sticky top-0 z-20 h-16 bg-white/85 backdrop-blur-xl border-b border-slate-200/70 shadow-sm flex items-center justify-between px-4 sm:px-6 gap-4 shrink-0">
      <div class="flex items-center gap-3">
        <button type="button" id="mobile-menu-btn" class="lg:hidden p-2 -ml-2 rounded-lg text-slate-600 hover:bg-slate-100 transition-colors cursor-pointer">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
        <div class="text-sm">
          <span class="text-slate-400" id="topbar-context">Projects</span>
          <span class="text-slate-300 mx-1.5 hidden sm:inline" id="topbar-sep" style="display:none">/</span>
          <span class="font-semibold text-slate-800 hidden sm:inline" id="topbar-page">Overview</span>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-100 border border-slate-200 text-xs text-slate-600">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span id="topbar-email" class="font-semibold text-slate-800 max-w-[10rem] truncate">…</span>
        </div>
      </div>
    </header>

    <main class="flex-1 bg-[#FAF9F5]">
      <!-- VIEW: Projects -->
      <div id="view-projects" class="py-8 sm:py-12">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
            <div>
              <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Projects</h1>
              <p class="mt-1 text-sm text-slate-500 max-w-xl">Run SEO audits, discover search &amp; Reddit opportunities, and track AI citations.</p>
            </div>
            <button type="button" id="btn-new-project" class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-xl shadow-md shadow-blue-600/20 transition-colors cursor-pointer">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
              New project
            </button>
          </div>
          <div id="projects-error" class="hidden mb-6 px-4 py-3 rounded-xl bg-rose-50 border border-rose-200 text-sm text-rose-700"></div>
          <div id="projects-loading" class="hidden grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
            {[1,2,3].map(() => (
              <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 animate-pulse">
                <div class="flex items-start justify-between mb-4">
                  <div class="flex-1"><div class="h-4 w-3/4 bg-slate-200 rounded mb-2"></div><div class="h-3 w-1/2 bg-slate-100 rounded"></div></div>
                  <div class="w-14 h-14 bg-slate-100 rounded-xl"></div>
                </div>
                <div class="flex items-center gap-2 mb-4"><div class="h-5 w-16 bg-slate-100 rounded-full"></div><div class="h-3 w-20 bg-slate-100 rounded"></div></div>
                <div class="flex gap-2 pt-3 border-t border-slate-100"><div class="h-9 flex-1 bg-slate-100 rounded-lg"></div><div class="h-9 flex-1 bg-slate-100 rounded-lg"></div><div class="h-9 w-16 bg-slate-100 rounded-lg"></div></div>
              </div>
            ))}
          </div>
          <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4"></div>
          <div id="projects-empty" class="hidden text-center py-20 px-6 border-2 border-dashed border-slate-200 rounded-3xl">
            <div class="mx-auto w-14 h-14 rounded-2xl bg-blue-50 border border-blue-200 flex items-center justify-center text-blue-600 mb-4">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>
            </div>
            <h2 class="text-lg font-bold text-slate-900">No projects yet</h2>
            <p class="mt-1 text-sm text-slate-500 max-w-md mx-auto">Add a website to start tracking its visibility.</p>
            <button type="button" id="btn-empty-new" class="mt-5 inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-xl shadow-md shadow-blue-600/20 transition-colors cursor-pointer">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
              Analyze your first website
            </button>
          </div>
        </div>
      </div>

      <!-- VIEW: Project Dashboard -->
      <div id="view-dashboard" class="hidden py-8 sm:py-10">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex flex-wrap items-start justify-between gap-4 mb-8">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-600 flex items-center justify-center text-white font-bold text-lg shadow-lg shadow-blue-600/20" id="dash-icon">—</div>
              <div>
                <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight" id="dash-domain">—</h1>
                <div class="flex items-center gap-3 mt-1 text-xs text-slate-500">
                  <span id="dash-scan-status" class="inline-flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span><span>No scans yet</span></span>
                  <span class="text-slate-300">·</span>
                  <span id="dash-last-scan">—</span>
                </div>
              </div>
            </div>
            <button type="button" id="btn-run-scan" class="inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-xl shadow-md shadow-blue-600/20 transition-colors cursor-pointer">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
              <span id="btn-scan-text">Run New Scan</span>
            </button>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4 text-center">
              <div class="text-3xl font-black text-blue-700 leading-none" id="dash-score">—</div>
              <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mt-1.5">Omni-Visibility</div>
            </div>
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4 text-center">
              <div class="text-3xl font-black text-emerald-600 leading-none" id="dash-pages">—</div>
              <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mt-1.5">Pages Crawled</div>
            </div>
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4 text-center">
              <div class="text-3xl font-black text-blue-600 leading-none" id="dash-opps">—</div>
              <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mt-1.5">Search Opps</div>
            </div>
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4 text-center">
              <div class="text-3xl font-black text-orange-500 leading-none" id="dash-reddit">—</div>
              <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mt-1.5">Reddit Disc.</div>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 card-hover flex flex-col" id="card-technical">
              <div class="flex items-center justify-between mb-3">
                <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-700"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> Technical Health</span>
                <span class="status-badge inline-flex items-center px-2 py-0.5 rounded-full border text-[10px] font-bold bg-slate-100 text-slate-500 border-slate-200" id="status-technical">Awaiting scan</span>
              </div>
              <div class="flex-1 min-h-[4rem]" id="body-technical"><div class="text-xs text-slate-400">Run a scan to check technical health.</div></div>
              <div class="pt-3 mt-3 border-t border-slate-100"><button type="button" class="view-report-btn text-xs font-semibold text-blue-600 hover:text-blue-800 transition-colors cursor-pointer" data-report="technical">View Report →</button></div>
            </div>
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 card-hover flex flex-col" id="card-search">
              <div class="flex items-center justify-between mb-3">
                <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-700"><span class="w-2 h-2 rounded-full bg-blue-500"></span> Search Opportunities</span>
                <span class="status-badge inline-flex items-center px-2 py-0.5 rounded-full border text-[10px] font-bold bg-slate-100 text-slate-500 border-slate-200" id="status-search">Awaiting scan</span>
              </div>
              <div class="flex-1 min-h-[4rem]" id="body-search"><div class="text-xs text-slate-400">Run a scan to discover search opportunities.</div></div>
              <div class="pt-3 mt-3 border-t border-slate-100"><button type="button" class="view-report-btn text-xs font-semibold text-blue-600 hover:text-blue-800 transition-colors cursor-pointer" data-report="search">View Report →</button></div>
            </div>
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 card-hover flex flex-col" id="card-reddit">
              <div class="flex items-center justify-between mb-3">
                <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-700"><span class="w-2 h-2 rounded-full bg-orange-500"></span> Reddit Intelligence</span>
                <span class="status-badge inline-flex items-center px-2 py-0.5 rounded-full border text-[10px] font-bold bg-slate-100 text-slate-500 border-slate-200" id="status-reddit">Awaiting scan</span>
              </div>
              <div class="flex-1 min-h-[4rem]" id="body-reddit"><div class="text-xs text-slate-400">Run a scan to find Reddit discussions.</div></div>
              <div class="pt-3 mt-3 border-t border-slate-100"><button type="button" class="view-report-btn text-xs font-semibold text-blue-600 hover:text-blue-800 transition-colors cursor-pointer" data-report="reddit">View Report →</button></div>
            </div>
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 card-hover flex flex-col" id="card-ai">
              <div class="flex items-center justify-between mb-3">
                <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-700"><span class="w-2 h-2 rounded-full bg-violet-500"></span> AI Engine Footprint</span>
                <span class="status-badge inline-flex items-center px-2 py-0.5 rounded-full border text-[10px] font-bold bg-slate-100 text-slate-500 border-slate-200" id="status-ai">Awaiting scan</span>
              </div>
              <div class="flex-1 min-h-[4rem]" id="body-ai"><div class="text-xs text-slate-400">Run a scan to check AI visibility.</div></div>
              <div class="pt-3 mt-3 border-t border-slate-100"><button type="button" class="view-report-btn text-xs font-semibold text-blue-600 hover:text-blue-800 transition-colors cursor-pointer" data-report="ai">View Report →</button></div>
            </div>
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 card-hover flex flex-col" id="card-content">
              <div class="flex items-center justify-between mb-3">
                <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-700"><span class="w-2 h-2 rounded-full bg-indigo-500"></span> Content Opportunities</span>
                <span class="status-badge inline-flex items-center px-2 py-0.5 rounded-full border text-[10px] font-bold bg-slate-100 text-slate-500 border-slate-200" id="status-content">Awaiting scan</span>
              </div>
              <div class="flex-1 min-h-[4rem]" id="body-content"><div class="text-xs text-slate-400">Run a scan to generate content ideas.</div></div>
              <div class="pt-3 mt-3 border-t border-slate-100"><button type="button" class="view-report-btn text-xs font-semibold text-blue-600 hover:text-blue-800 transition-colors cursor-pointer" data-report="content">View Report →</button></div>
            </div>
            <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl border border-blue-200/80 shadow-sm p-5 flex flex-col" id="card-recommendation">
              <div class="flex items-center gap-2 mb-3">
                <svg class="w-4 h-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>
                <span class="text-xs font-bold uppercase tracking-wider text-blue-800">Recommended Growth Move</span>
              </div>
              <div class="flex-1 min-h-[4rem] text-sm text-blue-900 leading-relaxed" id="body-recommendation">
                <div class="text-blue-400 text-xs">Run a scan to get personalized recommendations.</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- VIEW: Settings -->
      <div id="view-settings" class="hidden py-8 sm:py-12">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex items-center justify-between mb-6">
            <button type="button" class="btn-back-dashboard px-4 py-2 text-xs font-semibold text-blue-600 bg-blue-50 border border-blue-200 rounded-lg hover:bg-blue-100 transition-colors cursor-pointer">← Back to Dashboard</button>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Settings</h1>
          </div>
          <p class="mt-1 text-sm text-slate-500">Manage your account and subscription.</p>

          <div id="settings-loading" class="mt-8 flex flex-col items-center justify-center gap-3 py-12">
            <div class="w-6 h-6 border-2 border-blue-200 border-t-blue-600 rounded-full animate-spin"></div>
            <p class="text-sm text-slate-500 font-medium">Loading account…</p>
          </div>

          <div id="settings-content" class="hidden mt-8 space-y-6">

            <!-- Account -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
              <div class="p-5 border-b border-slate-100">
                <div class="text-xs font-bold uppercase tracking-wider text-slate-500">Account</div>
              </div>
              <div class="p-5 space-y-4">
                <div class="flex items-center justify-between gap-4">
                  <div class="min-w-0">
                    <div class="text-xs text-slate-500">Email</div>
                    <div class="mt-0.5 text-sm text-slate-900 font-semibold truncate" id="settings-email">…</div>
                  </div>
                  <span class="shrink-0 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold border border-emerald-100">Signed in</span>
                </div>
                <div class="flex items-center justify-between gap-4">
                  <div>
                    <div class="text-xs text-slate-500">Member since</div>
                    <div class="mt-0.5 text-sm text-slate-700 font-medium" id="settings-join-date">—</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Plan & Billing -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
              <div class="p-5 border-b border-slate-100">
                <div class="text-xs font-bold uppercase tracking-wider text-slate-500">Plan &amp; Billing</div>
              </div>
              <div class="p-5">
                <div class="flex items-center justify-between gap-4">
                  <div>
                    <div class="flex items-center gap-2">
                      <span class="text-sm font-bold text-slate-900" id="settings-plan-label">Free</span>
                      <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider border" id="settings-plan-badge">—</span>
                    </div>
                    <p class="mt-1 text-xs text-slate-500" id="settings-plan-desc">1 project, 1 scan, limited modules.</p>
                  </div>
                  <a href="/#pricing" id="settings-upgrade-btn" class="shrink-0 inline-flex items-center gap-1.5 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-xl transition-colors">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>
                    Upgrade to Pro
                  </a>
                </div>
              </div>
            </div>

            <!-- Usage & Limits -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
              <div class="p-5 border-b border-slate-100">
                <div class="text-xs font-bold uppercase tracking-wider text-slate-500">Usage &amp; Limits</div>
              </div>
              <div class="p-5 space-y-4">
                <div class="flex items-center justify-between">
                  <span class="text-sm text-slate-700">Projects</span>
                  <span class="text-sm font-semibold text-slate-900"><span id="settings-projects-used">0</span> / <span id="settings-projects-limit">1</span></span>
                </div>
                <div class="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden">
                  <div id="settings-projects-bar" class="h-full bg-blue-400 rounded-full transition-all" style="width:0%"></div>
                </div>
                <div class="flex items-center justify-between">
                  <span class="text-sm text-slate-700">Lifetime scans</span>
                  <span class="text-sm font-semibold text-slate-900"><span id="settings-scans-used">0</span> / <span id="settings-scans-limit">1</span></span>
                </div>
                <div class="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden">
                  <div id="settings-scans-bar" class="h-full bg-blue-400 rounded-full transition-all" style="width:0%"></div>
                </div>
                <div id="settings-reddit-usage" class="hidden pt-3 border-t border-slate-100 space-y-3">
                  <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Reddit Intelligence</div>
                  <div class="flex items-center justify-between">
                    <span class="text-sm text-slate-700">Weekly scans</span>
                    <span class="text-sm font-semibold text-slate-900"><span id="settings-reddit-weekly-used">0</span> / <span id="settings-reddit-weekly-limit">1</span></span>
                  </div>
                  <div class="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden">
                    <div id="settings-reddit-weekly-bar" class="h-full bg-orange-400 rounded-full transition-all" style="width:0%"></div>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-sm text-slate-700">Monthly scans</span>
                    <span class="text-sm font-semibold text-slate-900"><span id="settings-reddit-monthly-used">0</span> / <span id="settings-reddit-monthly-limit">4</span></span>
                  </div>
                  <div class="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden">
                    <div id="settings-reddit-monthly-bar" class="h-full bg-orange-400 rounded-full transition-all" style="width:0%"></div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Projects -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
              <div class="p-5 border-b border-slate-100">
                <div class="text-xs font-bold uppercase tracking-wider text-slate-500">Projects</div>
              </div>
              <div id="settings-projects-list" class="divide-y divide-slate-100">
                <div class="p-5 text-sm text-slate-400">No projects yet.</div>
              </div>
            </div>

            <!-- Sign Out -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
              <div class="p-5 flex items-center justify-between gap-4">
                <div>
                  <div class="text-xs font-bold uppercase tracking-wider text-slate-500">Session</div>
                  <p class="mt-1 text-sm text-slate-500">End your session on this device.</p>
                </div>
                <button type="button" id="btn-settings-logout" class="shrink-0 px-4 py-2 text-xs font-semibold text-rose-700 bg-white border border-rose-200 rounded-lg hover:bg-rose-50 transition-colors cursor-pointer">Log out</button>
              </div>
            </div>

            <!-- Danger Zone -->
            <div class="bg-white rounded-2xl border border-rose-200 shadow-sm overflow-hidden">
              <div class="p-5 border-b border-rose-100">
                <div class="text-xs font-bold uppercase tracking-wider text-rose-500">Danger Zone</div>
              </div>
              <div class="p-5 flex items-center justify-between gap-4">
                <div>
                  <div class="text-sm font-semibold text-slate-900">Delete account</div>
                  <p class="mt-0.5 text-xs text-slate-500">Permanently remove your account and all associated data. This action cannot be undone.</p>
                </div>
                <button type="button" disabled class="shrink-0 px-4 py-2 text-xs font-semibold text-slate-400 bg-slate-50 border border-slate-200 rounded-lg cursor-not-allowed" title="Coming soon">Delete account</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- VIEW: Technical Health Report -->
      <div id="view-report" class="hidden py-8 sm:py-10">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <div id="report-loading" class="flex flex-col items-center justify-center gap-3 py-20">
            <div class="w-8 h-8 border-2 border-blue-200 border-t-blue-600 rounded-full animate-spin"></div>
            <p class="text-sm text-slate-500 font-medium">Loading report…</p>
          </div>
          <div id="report-error" class="hidden text-center py-20">
            <p class="text-sm text-rose-600" id="report-error-msg">Failed to load report.</p>
            <button type="button" id="btn-report-back-error" class="mt-4 px-4 py-2 text-xs font-semibold text-blue-600 bg-blue-50 border border-blue-200 rounded-lg hover:bg-blue-100 transition-colors cursor-pointer">← Back to Dashboard</button>
          </div>
          <div id="report-content" class="hidden"></div>
        </div>
      </div>
    </main>
  </div>

  <!-- Create project modal -->
  <div id="modal-create" class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-sm" role="dialog" aria-modal="true">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-xl border border-slate-200 p-6" data-modal-panel>
      <h2 class="text-lg font-bold text-slate-900">Create a new project</h2>
      <p class="mt-1 text-sm text-slate-500">Add a website to start tracking.</p>
      <form id="form-create" class="mt-4 space-y-4">
        <div>
          <label for="input-create-name" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Project name <span class="font-medium normal-case text-slate-400">(optional)</span></label>
          <input type="text" id="input-create-name" placeholder="e.g. Marketing site" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />
        </div>
        <div>
          <label for="input-create-url" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Website URL</label>
          <input type="text" id="input-create-url" required placeholder="yourcompany.com" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />
        </div>
        <div id="create-error" class="hidden px-3 py-2.5 rounded-lg bg-rose-50 border border-rose-200 text-sm text-rose-700"></div>
        <div class="flex justify-end gap-2">
          <button type="button" id="btn-create-cancel" class="px-4 py-2 text-sm font-semibold text-slate-700 bg-white border border-slate-300 rounded-xl hover:bg-slate-100 transition-colors cursor-pointer">Cancel</button>
          <button type="submit" id="btn-create-submit" class="px-5 py-2.5 bg-slate-900 hover:bg-blue-700 text-white text-sm font-semibold rounded-xl transition-colors cursor-pointer">Create project</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Rename modal -->
  <div id="modal-rename" class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-sm" role="dialog" aria-modal="true">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-xl border border-slate-200 p-6" data-modal-panel>
      <h2 class="text-lg font-bold text-slate-900">Rename project</h2>
      <p class="mt-1 text-sm text-slate-500">Update the name of <span id="rename-domain" class="font-mono font-semibold text-slate-700"></span>.</p>
      <label for="input-rename" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mt-4 mb-1.5">Project name</label>
      <input type="text" id="input-rename" maxlength="255" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 bg-white text-sm text-slate-900 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />
      <div id="rename-error" class="hidden mt-3 px-3 py-2.5 rounded-lg bg-rose-50 border border-rose-200 text-sm text-rose-700"></div>
      <div class="flex justify-end gap-2 mt-5">
        <button type="button" id="btn-rename-cancel" class="px-4 py-2 text-sm font-semibold text-slate-700 bg-white border border-slate-300 rounded-xl hover:bg-slate-100 transition-colors cursor-pointer">Cancel</button>
        <button type="button" id="btn-rename-submit" class="px-4 py-2 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-xl transition-colors cursor-pointer">Save name</button>
      </div>
    </div>
  </div>

  <!-- Delete modal -->
  <div id="modal-delete" class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-sm" role="dialog" aria-modal="true">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-xl border border-slate-200 p-6" data-modal-panel>
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-rose-50 border border-rose-200 flex items-center justify-center text-rose-600">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
        </div>
        <div>
          <h2 class="text-lg font-bold text-slate-900">Delete project?</h2>
          <p class="text-xs text-slate-500 font-mono" id="delete-domain">—</p>
        </div>
      </div>
      <p class="mt-4 text-sm text-slate-600 leading-relaxed">This will permanently delete this project and <strong>all of its scans, audit results, and history</strong>. This action cannot be undone.</p>
      <div id="delete-error" class="hidden mt-3 px-3 py-2.5 rounded-lg bg-rose-50 border border-rose-200 text-sm text-rose-700"></div>
      <div class="flex justify-end gap-2 mt-5">
        <button type="button" id="btn-delete-cancel" class="px-4 py-2 text-sm font-semibold text-slate-700 bg-white border border-slate-300 rounded-xl hover:bg-slate-100 transition-colors cursor-pointer">Cancel</button>
        <button type="button" id="btn-delete-submit" class="px-4 py-2 text-sm font-semibold text-white bg-rose-600 hover:bg-rose-700 rounded-xl transition-colors cursor-pointer">Delete project</button>
      </div>
    </div>
  </div>

  <footer class="lg:ml-64 text-center py-6 text-xs text-slate-400">&copy; Foundable · Only you can see your projects and scans.</footer>
</Layout>


---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import SearchEverywhere from '../components/SearchEverywhere.astro';
import ModulesExperience from '../components/ModulesExperience.astro';
import GrowthGraph from '../components/GrowthGraph.astro';
import ProductFlow from '../components/ProductFlow.astro';
import DemoScanner from '../components/DemoScanner.astro';
import Pricing from '../components/Pricing.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="VerseSEO — Visibility Intelligence for Modern Search, Reddit & AI"
  description="The all-in-one visibility platform for small businesses, SaaS founders, and creators. Fix technical flaws, capture search intent, discover Reddit opportunities, and track ChatGPT & Perplexity citations."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "VerseSEO",
    "url": "https://verseseo.com",
    "logo": "https://verseseo.com/brand/logo-horizontal.svg",
    "description": "Lightweight SEO, Reddit opportunity discovery, and AI answer engine intelligence for small businesses, SaaS founders, and creators.",
    "sameAs": []
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "VerseSEO",
    "url": "https://verseseo.com",
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "https://verseseo.com/login?next=/app&website={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    }
  })} />
  <!-- Global Navigation -->
  <Navbar />

  <main class="flex-grow">
    <!-- Hero Section with Dynamic Headline & Synced Visual -->
    <Hero />

    <!-- Fragmented Discovery Shift ("Your customers don't search in just one place") -->
    <SearchEverywhere />

    <!-- Five Product Modules — Immersive Scroll Experience -->
    <ModulesExperience />

    <!-- Growth Visualization — Organic / Direct / Referral -->
    <GrowthGraph />

    <!-- Product Workflow / How It Connects -->
    <ProductFlow />

    <!-- Interactive Demo Scanner -->
    <DemoScanner />

    <!-- Pricing Section -->
    <Pricing />

    <!-- Frequently Asked Questions -->
    <FAQ />

    <!-- Final Call to Action -->
    <FinalCTA />
  </main>

  <!-- Global Footer -->
  <Footer />
</Layout>

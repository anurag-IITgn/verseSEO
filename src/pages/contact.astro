---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Support — VerseSEO"
  description="Get in touch with VerseSEO support. We're here to help with your SEO, Reddit discovery, and AI visibility questions."
  robots="noindex, nofollow"
>
  <main class="min-h-screen flex flex-col">
    <header class="w-full border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded-lg p-1">
          <img src="/brand/logo-mark-new.png" alt="VerseSEO icon" class="w-9 h-9 rounded-xl object-cover" />
          <span class="font-extrabold text-xl tracking-tight text-slate-900">VerseSEO</span>
        </a>
        <a href="/" class="text-sm font-medium text-slate-600 hover:text-slate-900 hover:underline">← Back to home</a>
      </div>
    </header>

    <div class="flex-1 flex items-center justify-center px-4 sm:px-6 py-12 sm:py-16">
      <div class="w-full max-w-lg">
        <div class="text-center mb-8">
          <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Contact Support</h1>
          <p class="mt-3 text-sm text-slate-500">
            Have a question, need help, or want to share feedback? We'd love to hear from you. Messages are sent directly to <span class="font-medium text-slate-700">support@verseseo.com</span>.
          </p>
        </div>

        <form
          action="https://formspree.io/f/xwlegnel"
          method="POST"
          class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8 space-y-5"
        >
          <div>
            <label for="name" class="block text-sm font-semibold text-slate-700 mb-1.5">Name</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Your name"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-slate-900 placeholder:text-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold text-slate-700 mb-1.5">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="you@example.com"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-slate-900 placeholder:text-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-slate-700 mb-1.5">Message</label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              placeholder="How can we help you?"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-slate-900 placeholder:text-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm rounded-xl transition-colors cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2"
          >
            Send Message
          </button>
        </form>

        <p class="mt-6 text-center text-xs text-slate-400">
          We typically respond within 24 hours on business days.
        </p>
      </div>
    </div>

    <footer class="text-center py-8 text-xs text-slate-400">
      &copy; VerseSEO · Powered by real crawl data, not guesses.
    </footer>
  </main>
</Layout>

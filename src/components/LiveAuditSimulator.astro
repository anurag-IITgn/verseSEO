---
// LiveAuditSimulator.astro
interface Props {
  mode?: 'teaser' | 'app';
}

const { mode = 'teaser' } = Astro.props;
---

<section class="py-16 sm:py-24 bg-[#FAF9F5] border-b border-slate-200/80 relative" id="demo" data-mode={mode}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {mode === 'teaser' &&
      <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200/60 text-xs font-bold text-emerald-800 uppercase tracking-wider mb-3">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Interactive Live Simulator
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Test the microtool on real sample websites.
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
        Experience how Foundable unifies technical SEO, high-intent keywords, Reddit listening, and AI citations in under 30 seconds.
      </p>
    </div>
    }

    <!-- Simulator Shell Container -->
    <div class="bg-white rounded-3xl border border-slate-200/90 shadow-2xl shadow-slate-900/10 p-6 sm:p-8 lg:p-10 max-w-5xl mx-auto">

      <!-- Input Controls & Preset Selector -->
      <div class="space-y-4 mb-8">

        {mode === 'teaser' &&
        <>
        <!-- Preset selector chips -->
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500 font-mono">Select Sample Persona:</span>
          <div class="flex flex-wrap gap-2" id="sim-persona-chips">
            <button 
              type="button" 
              class="sim-persona-btn active px-3 py-1.5 rounded-lg bg-[#0c1021] text-white text-xs font-semibold cursor-pointer transition-all"
              data-domain="resumeforge.io"
              data-category="saas"
            >
              💻 SaaS Startup (resumeforge.io)
            </button>
            <button 
              type="button" 
              class="sim-persona-btn px-3 py-1.5 rounded-lg bg-white text-slate-700 hover:bg-slate-100 border border-slate-200 text-xs font-semibold cursor-pointer transition-all"
              data-domain="aeroroast.co"
              data-category="ecommerce"
            >
              ☕ E-Commerce (aeroroast.co)
            </button>
            <button 
              type="button" 
              class="sim-persona-btn px-3 py-1.5 rounded-lg bg-white text-slate-700 hover:bg-slate-100 border border-slate-200 text-xs font-semibold cursor-pointer transition-all"
              data-domain="apexpt.com"
              data-category="local"
            >
              🏥 Local Clinic (apexpt.com)
            </button>
            <button 
              type="button" 
              class="sim-persona-btn px-3 py-1.5 rounded-lg bg-white text-slate-700 hover:bg-slate-100 border border-slate-200 text-xs font-semibold cursor-pointer transition-all"
              data-domain="coursecraft.dev"
              data-category="creator"
            >
              🎨 Creator Platform (coursecraft.dev)
            </button>
          </div>
        </div>

        <!-- URL Input & Scan Action Bar -->
        <div class="flex flex-col sm:flex-row items-center gap-2 p-2 bg-white rounded-2xl border border-slate-300 shadow-sm focus-within:border-blue-500 focus-within:ring-4 focus-within:ring-blue-500/10">
          <div class="flex items-center gap-2.5 w-full px-3 py-1.5">
            <span class="text-slate-400 font-mono text-xs sm:text-sm">https://</span>
            <input 
              type="text" 
              id="sim-domain-input" 
              value="resumeforge.io" 
              class="w-full text-sm sm:text-base font-semibold text-slate-900 focus:outline-none bg-transparent"
              placeholder="e.g. yourcompany.com"
            />
          </div>
          <button 
            type="button" 
            id="sim-run-btn" 
            class="w-full sm:w-auto shrink-0 inline-flex items-center justify-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-md shadow-blue-600/20 cursor-pointer transition-all"
          >
            <span id="sim-btn-text">Run Instant Scan</span>
            <svg id="sim-btn-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </button>
        </div>
        </>
        }

        {mode === 'app' &&
        <>
        <!-- App-mode project bar -->
        <div class="flex flex-col sm:flex-row items-center gap-3 p-2 bg-white rounded-2xl border border-slate-300 shadow-sm">
          <div class="flex items-center gap-2.5 w-full px-3 py-1.5">
            <span class="text-slate-400 font-mono text-xs sm:text-sm shrink-0">Project:</span>
            <select 
              id="sim-project-select" 
              class="w-full text-sm sm:text-base font-semibold text-slate-900 focus:outline-none bg-transparent cursor-pointer"
            ></select>
          </div>
          <button 
            type="button" 
            id="sim-run-btn" 
            class="w-full sm:w-auto shrink-0 inline-flex items-center justify-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm rounded-xl shadow-md shadow-blue-600/20 cursor-pointer transition-all"
          >
            <span id="sim-btn-text">Run New Scan</span>
            <svg id="sim-btn-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </button>
        </div>
        <p id="sim-app-project-meta" class="text-xs text-slate-500 font-mono"></p>
        </>
        }

      </div>

      <!-- Scanning Progress Simulation (Hidden initially) -->
      <div id="sim-progress-box" class="hidden p-8 rounded-2xl bg-white border border-slate-200 text-center space-y-4 mb-8">
        <div class="flex justify-center">
          <div class="w-10 h-10 border-3 border-blue-600 border-t-transparent rounded-full animate-spin"></div>
        </div>
        <div class="space-y-1">
          <h4 class="text-base font-bold text-slate-900" id="sim-progress-title">Scanning Website Infrastructure...</h4>
          <p class="text-xs text-slate-500 font-mono" id="sim-progress-subtitle">Fetching robots.txt, sitemap.xml, SSL headers, and LLM entity associations</p>
        </div>
        <div class="w-full max-w-md mx-auto bg-slate-100 rounded-full h-2 overflow-hidden">
          <div id="sim-progress-bar" class="bg-blue-600 h-2 rounded-full transition-all duration-300" style="width: 15%"></div>
        </div>
      </div>

      <!-- Simulator Output Card Display -->
      <div id="sim-results-box" class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-5 sm:p-8 space-y-6">
        
        <!-- Results Header Banner -->
        <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-slate-100">
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-400 font-mono">Target Scanned</span>
              <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 text-xs font-bold border border-emerald-100">
                Audit Verified
              </span>
            </div>
            <h3 class="text-xl sm:text-2xl font-black text-slate-900 mt-1 font-mono" id="sim-result-domain">
              resumeforge.io
            </h3>
          </div>

          <!-- Overall Composite Score Badge -->
          <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200/80 rounded-2xl px-5 py-3 text-right">
            <span class="text-[11px] font-bold uppercase tracking-wider text-blue-900 block">Omni-Visibility Index</span>
            <div class="text-2xl sm:text-3xl font-black text-blue-700" id="sim-result-score">
              -- <span class="text-sm font-normal text-slate-400">/ 100</span>
            </div>
          </div>
        </div>

        <!-- 4 Grid Sub-Panels -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          
          <!-- Box 1: Technical Health Findings -->
          <div class="p-4 rounded-xl border border-slate-200 bg-white/70 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span> 1. Technical Health
              </span>
              <span class="text-xs font-bold text-emerald-700" id="sim-tech-status">Awaiting scan</span>
            </div>
            <div class="space-y-1.5 text-xs text-slate-600 font-mono" id="sim-tech-items">
              <div class="flex items-center gap-1.5 text-slate-400">Run a scan to load real technical SEO results.</div>
            </div>
          </div>

          <!-- Box 2: Search Intent Opportunities -->
          <div class="p-4 rounded-xl border border-slate-200 bg-white/70 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-blue-600"></span> 2. Search Intent
              </span>
              <span class="text-xs font-bold text-blue-700" id="sim-search-status">Awaiting scan</span>
            </div>
            <div class="space-y-1.5 text-xs text-slate-600 font-mono" id="sim-search-items">
              <div class="text-slate-400">Run a scan to discover real search opportunities.</div>
            </div>
          </div>

          <!-- Box 3: Reddit Community Opportunities -->
          <div class="p-4 rounded-xl border border-slate-200 bg-white/70 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-orange-500"></span> 3. Reddit Intel
              </span>
              <span class="text-xs font-bold text-orange-700" id="sim-reddit-status">Awaiting scan</span>
            </div>
            <div class="space-y-1.5 text-xs text-slate-600 font-mono" id="sim-reddit-items">
              <div class="text-slate-400">Run a scan to look for relevant Reddit discussions.</div>
            </div>
          </div>

          <!-- Box 4: AI Answer Citation Status -->
          <div class="p-4 rounded-xl border border-slate-200 bg-white/70 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-violet-600"></span> 4. AI Engine Footprint
              </span>
              <span class="text-xs font-bold text-violet-700" id="sim-ai-status">Awaiting scan</span>
            </div>
            <div class="space-y-1 text-xs text-slate-600 font-mono" id="sim-ai-items">
              <div class="text-slate-400">Run a scan to check your AI engine footprint.</div>
            </div>
          </div>

          <!-- Box 5: Content Generator -->
          <div class="p-4 rounded-xl border border-slate-200 bg-white/70 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-indigo-600"></span> 5. Content Generator
              </span>
              <span class="text-xs font-bold text-indigo-700" id="sim-content-status">Awaiting scan</span>
            </div>
            <div class="space-y-1.5 text-xs text-slate-600 font-mono" id="sim-content-items">
              <div class="text-slate-400">Run a scan to generate content recommendations.</div>
            </div>
          </div>

        </div>

        <!-- Scan History & Previous Scan -->
        <div id="sim-history-section" class="hidden p-4 rounded-xl bg-slate-50/70 border border-slate-200 space-y-3">
          <div class="flex items-center justify-between gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-slate-800"></span> Scan History & Previous Scan
            </span>
            <span class="text-xs font-bold text-slate-500 font-mono" id="sim-history-count"></span>
          </div>
          <div class="text-xs text-slate-600 font-mono space-y-2" id="sim-history-body">
            <div class="text-slate-400">Run a scan to load scan history and the previous scan comparison.</div>
          </div>
        </div>

        <!-- Priority Action Box -->
        <div class="p-4 rounded-xl bg-blue-50/80 border border-blue-200 text-xs sm:text-sm text-slate-700 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div>
            <strong class="text-blue-950 block">Next Recommended Growth Move:</strong>
            <span id="sim-next-action">Publish the "Student Resume Outline" brief to unlock Gemini AI citations and capture +4,800 monthly search clicks.</span>
          </div>
          <button 
            type="button" 
            class="shrink-0 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg transition-colors cursor-pointer text-xs"
            onclick="alert('Full report generator will be available with connected V1 accounts!')"
          >
            Generate Full Plan →
          </button>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  interface PersonaData {
    domain: string;
    score: string;
    techStatus: string;
    techItems: string[];
    nextAction: string;
  }

  const personaDatabase: Record<string, PersonaData> = {
    "resumeforge.io": {
      domain: "resumeforge.io",
      score: "84",
      techStatus: "88% (Healthy)",
      techItems: [
        "✓ HTTPS & HSTS active (TLS 1.3)",
        "✓ Sitemap contains 142 valid URLs",
        "⚠ 3 Missing meta descriptions on /templates"
      ],
      nextAction: "Publish the 'Student Resume Guide' content brief to trigger Google Gemini AI citations and capture 4,800 monthly organic visits."
    },
    "aeroroast.co": {
      domain: "aeroroast.co",
      score: "79",
      techStatus: "82% (Good)",
      techItems: [
        "✓ Fast LCP: 0.9s on mobile",
        "✓ Structured Product Schema present",
        "⚠ 8 Broken image alt attributes"
      ],
      nextAction: "Create a brewing guide for Ethiopian origins to satisfy r/Coffee recommendation criteria and capture Claude citation signals."
    },
    "apexpt.com": {
      domain: "apexpt.com",
      score: "72",
      techStatus: "76% (Needs Fixes)",
      techItems: [
        "✓ Local Business Schema active",
        "⚠ Missing OpenGraph tags on /contact",
        "⚠ Mobile viewport tap targets too small"
      ],
      nextAction: "Implement structured FAQ Schema on your conditions treated pages to trigger local ChatGPT & Gemini health service citations."
    },
    "coursecraft.dev": {
      domain: "coursecraft.dev",
      score: "87",
      techStatus: "94% (Excellent)",
      techItems: [
        "✓ 0 Broken links detected",
        "✓ Canonical URLs properly configured",
        "✓ Superfast TTFB (120ms)"
      ],
      nextAction: "Maintain high authority by answering common markdown LMS syntax questions in community documentation."
    }
  };

  // Backend API base. Override with PUBLIC_API_BASE_URL for non-local deployments.
  const API_BASE = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:3000';
  const simRoot = document.getElementById('demo');
  const SIM_MODE: 'teaser' | 'app' = simRoot?.dataset.mode === 'app' ? 'app' : 'teaser';

  const domainInput = document.getElementById('sim-domain-input') as HTMLInputElement | null;
  const runBtn = document.getElementById('sim-run-btn') as HTMLButtonElement | null;
  const personaBtns = document.querySelectorAll<HTMLButtonElement>('#sim-persona-chips .sim-persona-btn');
  const progressBox = document.getElementById('sim-progress-box');
  const resultsBox = document.getElementById('sim-results-box');
  const progressBar = document.getElementById('sim-progress-bar') as HTMLElement | null;
  const progressTitle = document.getElementById('sim-progress-title');
  const progressSubtitle = document.getElementById('sim-progress-subtitle');
  const appProjectMeta = document.getElementById('sim-app-project-meta');

  const resDomain = document.getElementById('sim-result-domain');
  const resScore = document.getElementById('sim-result-score');
  const techStatus = document.getElementById('sim-tech-status');
  const techItems = document.getElementById('sim-tech-items');
  const searchStatus = document.getElementById('sim-search-status');
  const searchItems = document.getElementById('sim-search-items');
  const redditStatus = document.getElementById('sim-reddit-status');
  const redditItems = document.getElementById('sim-reddit-items');
  const aiStatus = document.getElementById('sim-ai-status');
  const aiItems = document.getElementById('sim-ai-items');
  const contentStatus = document.getElementById('sim-content-status');
  const contentItems = document.getElementById('sim-content-items');
  const nextAction = document.getElementById('sim-next-action');

  const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  function apiFetch(path: string, init: RequestInit = {}): Promise<Response> {
    const headers: Record<string, string> = { Accept: 'application/json', ...(init.headers as Record<string, string>) };
    if (typeof init.body === 'string') headers['Content-Type'] = 'application/json';
    return fetch(`${API_BASE}${path}`, { ...init, headers, credentials: 'include' });
  }

  async function backendError(res: Response): Promise<Error> {
    try {
      const body = await res.json();
      return new Error(body?.error?.message ?? `Backend request failed (${res.status})`);
    } catch {
      return new Error(`Backend request failed (${res.status})`);
    }
  }

  function toWebsiteUrl(input: string): string {
    const trimmed = input.trim();
    if (!trimmed) return '';
    if (/^https?:\/\//i.test(trimmed)) return trimmed.replace(/\/+$/, '');
    return `https://${trimmed.replace(/^www\./i, '')}`;
  }

  function domainKey(input: string): string {
    return input.toLowerCase().replace(/^(https?:\/\/)?(www\.)?/, '').replace(/\/.*$/, '');
  }

  function scoreLabel(score: number): string {
    if (score >= 90) return 'Excellent';
    if (score >= 75) return 'Healthy';
    if (score >= 60) return 'Good';
    if (score >= 40) return 'Needs Fixes';
    return 'Critical';
  }

  const issueLabels: Record<string, string> = {
    MISSING_HTTPS: 'Website not served over HTTPS',
    MISSING_ROBOTS_TXT: 'Missing robots.txt',
    MISSING_SITEMAP: 'Missing XML sitemap',
    MISSING_TITLE: 'Missing title tags',
    DUPLICATE_TITLE: 'Duplicate title tags',
    TITLE_TOO_SHORT: 'Titles below recommended length',
    TITLE_TOO_LONG: 'Titles above recommended length',
    MISSING_META_DESCRIPTION: 'Missing meta descriptions',
    DUPLICATE_META_DESCRIPTION: 'Duplicate meta descriptions',
    MISSING_CANONICAL: 'Missing canonical tags',
    NOINDEX_PAGE: 'Pages set to noindex',
    BROKEN_INTERNAL_LINK: 'Broken internal links',
    NON_200_PAGE: 'Pages returning non-200 responses',
  };

  const issueOrder = [
    'MISSING_HTTPS',
    'MISSING_ROBOTS_TXT',
    'MISSING_SITEMAP',
    'MISSING_TITLE',
    'DUPLICATE_TITLE',
    'TITLE_TOO_SHORT',
    'TITLE_TOO_LONG',
    'MISSING_META_DESCRIPTION',
    'DUPLICATE_META_DESCRIPTION',
    'MISSING_CANONICAL',
    'NOINDEX_PAGE',
    'BROKEN_INTERNAL_LINK',
    'NON_200_PAGE',
  ];

  function fallbackPersona(cleanDomain: string): PersonaData {
    return {
      domain: cleanDomain || 'mycustomsite.com',
      score: '81',
      techStatus: '84% (Good Health)',
      techItems: ['✓ HTTPS active & SSL verified', '✓ Sitemap discovered', '⚠ 2 Pages missing canonical tags'],
      nextAction: `Publish a dedicated comparison guide targeting keywords around ${cleanDomain} to trigger comprehensive AI citations.`,
    };
  }

  // Demo panels only simulate static content. Panels 2 (Search Intent),
  // 3 (Reddit Intel), 4 (AI Engine Footprint) and 5 (Content Generator)
  // are driven by the real backend.
  function renderDemoPanels(input: string) {
    const cleanDomain = domainKey(input);
    const persona = personaDatabase[cleanDomain] || fallbackPersona(cleanDomain);

    if (nextAction) nextAction.textContent = persona.nextAction;
  }

  // Technical Health panel + overall score are driven by the real backend results.
  function renderTechPanel(websiteUrl: string, results: {
    crawl?: { robotsFound?: boolean | null; sitemapFound?: boolean | null };
    pages?: unknown[];
    healthScore?: number | null;
    issueCount?: number;
    issueCounts?: Record<string, number>;
  }) {
    const crawl = results.crawl ?? {};
    const healthScore = typeof results.healthScore === 'number' ? results.healthScore : 0;
    const counts = results.issueCounts ?? {};

    if (resDomain) resDomain.textContent = websiteUrl.replace(/^https?:\/\//, '');
    if (resScore) resScore.innerHTML = `${healthScore} <span class="text-sm font-normal text-slate-400">/ 100</span>`;
    if (techStatus) techStatus.textContent = `${healthScore}% (${scoreLabel(healthScore)})`;

    const lines: string[] = [];
    for (const type of issueOrder) {
      const n = counts[type] ?? 0;
      if (n > 0) lines.push(`⚠ ${n} ${issueLabels[type]}`);
    }
    if (results.issueCount === 0) lines.push('✓ No technical issues found');
    if (crawl.robotsFound) lines.push('✓ robots.txt found');
    if (crawl.sitemapFound) lines.push('✓ XML sitemap found');
    if (Array.isArray(results.pages)) lines.push(`✓ Crawled ${results.pages.length} pages`);
    if (lines.length === 0) lines.push('✓ No technical issues found');

    if (techItems) {
      techItems.innerHTML = lines.map(line => {
        const isGood = line.startsWith('✓');
        return `<div class="flex items-center gap-1.5 ${isGood ? 'text-emerald-700' : 'text-amber-700'}">${line}</div>`;
      }).join('');
    }
  }

  // Panel 2 (Search Intent) is driven by real opportunities computed from the crawl.
  const opportunityTypeLabels: Record<string, string> = {
    CONTENT_GAP: 'Content gap',
    WEAK_TOPIC_COVERAGE: 'Weak coverage',
    EXISTING_PAGE_OPTIMIZATION: 'Page optimization',
    INTERNAL_LINK_OPPORTUNITY: 'Internal link',
    SEARCH_INTENT_GAP: 'Search intent',
  };

  function escapeHtml(value: string): string {
    return String(value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function priorityBadgeClass(priority: string): string {
    if (priority === 'high') return 'bg-rose-50 text-rose-700 border-rose-100';
    if (priority === 'medium') return 'bg-amber-50 text-amber-700 border-amber-100';
    return 'bg-slate-100 text-slate-600 border-slate-200';
  }

  function renderSearchPanelLoading() {
    if (searchStatus) {
      searchStatus.classList.remove('text-rose-600');
      searchStatus.classList.add('text-blue-700');
      searchStatus.textContent = 'Analyzing search intent...';
    }
    if (searchItems) {
      searchItems.innerHTML = '<div class="text-slate-400">Deriving opportunities from the crawled pages...</div>';
    }
  }

  function renderSearchPanelError(message: string) {
    if (searchStatus) {
      searchStatus.classList.remove('text-blue-700');
      searchStatus.classList.add('text-rose-600');
      searchStatus.textContent = 'Unavailable';
    }
    if (searchItems) {
      searchItems.innerHTML = `<div class="text-rose-600">${escapeHtml(message)}</div>`;
    }
  }

  function renderSearchPanel(data: {
    opportunities?: Array<{
      opportunityType: string;
      query: string;
      score: number;
      priority: string;
      reason: string;
      suggestedAction: string;
      relatedPageUrl: string | null;
    }>;
  }) {
    const opps = data?.opportunities ?? [];
    const highCount = opps.filter(o => o.priority === 'high').length;

    if (searchStatus) {
      searchStatus.classList.remove('text-rose-600');
      searchStatus.classList.add('text-blue-700');
      searchStatus.textContent = opps.length === 0
        ? 'No opportunities'
        : `${opps.length} Opportunities${highCount > 0 ? ` · ${highCount} High` : ''}`;
    }
    if (searchItems) {
      searchItems.innerHTML = opps.length === 0
        ? '<div class="text-slate-400">No actionable search opportunities found for this crawl.</div>'
        : opps.map(o => `
          <div class="bg-white p-2 rounded border border-slate-200/80 space-y-1">
            <div class="flex justify-between items-center gap-2">
              <span class="font-semibold truncate">"${escapeHtml(o.query)}"</span>
              <span class="${o.priority === 'high' ? 'text-rose-600' : 'text-blue-600'} font-bold font-mono ml-2 shrink-0">Score ${o.score}</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-[10px] font-bold uppercase tracking-wide px-1.5 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-100">${opportunityTypeLabels[o.opportunityType] ?? o.opportunityType}</span>
              <span class="text-[10px] font-bold uppercase tracking-wide px-1.5 py-0.5 rounded border ${priorityBadgeClass(o.priority)}">${o.priority}</span>
            </div>

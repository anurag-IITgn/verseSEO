  function renderRedditPanel(data: {
    status?: string;
    message?: string | null;
    discussions?: Array<{
      subreddit: string;
      postTitle: string;
      postUrl: string;
      author: string | null;
      score: number;
      numComments: number;
      postedAt: string | null;
      opportunityScore: number;
      priority: string;
      reason: string;
    }>;
  }) {
    if (data.status === 'unavailable') {
      renderRedditPanelNotConnected(data.message ?? 'Reddit discovery is unavailable.');
      return;
    }
    const discussions = data?.discussions ?? [];
    if (discussions.length === 0) {
      renderRedditPanelEmpty();
      return;
    }

    if (redditStatus) {
      redditStatus.classList.remove('text-slate-500', 'text-amber-700', 'text-rose-600');
      redditStatus.classList.add('text-orange-700');
      const highCount = discussions.filter(d => d.priority === 'high').length;
      redditStatus.textContent = `${discussions.length} Discussions${highCount > 0 ? ` · ${highCount} High` : ''}`;
    }
    if (redditItems) {
      redditItems.innerHTML = discussions.map(d => {
        const meta = [
          d.score > 0 ? `${d.score} upvotes` : null,
          d.numComments > 0 ? `${d.numComments} comments` : null,
          d.postedAt ? timeAgo(d.postedAt) : null,
        ].filter(Boolean).join(' • ');
        const scoreClass = d.priority === 'high' ? 'text-rose-600' : 'text-orange-600';
        return `
          <div class="bg-white p-2 rounded border border-slate-200/80 space-y-0.5">
            <span class="text-orange-600 font-bold">r/${escapeHtml(d.subreddit)}:</span> "<a href="${escapeHtml(d.postUrl)}" target="_blank" rel="noopener" class="text-slate-700 hover:text-orange-700 underline decoration-dotted">${escapeHtml(d.postTitle)}</a>"
            <div class="text-[10px] text-slate-400 font-mono mt-0.5">${escapeHtml(meta)}${meta ? ' · ' : ''}<span class="${scoreClass} font-bold">Score ${d.opportunityScore}</span></div>
            <div class="text-[11px] text-slate-500 mt-0.5">${escapeHtml(d.reason)}</div>
          </div>
        `;
      }).join('');
    }
  }

  async function loadRedditPanel(crawlId: string): Promise<void> {
    const deadline = Date.now() + 900000; // bounded wait for the provider pipeline
    const startedAt = Date.now();
    renderRedditPanelLoading(0);
    while (Date.now() < deadline) {
      try {
        const redditRes = await apiFetch(`/api/crawls/${crawlId}/reddit-opportunities`);
        if (!redditRes.ok) throw await backendError(redditRes);
        const data = await redditRes.json();
        if (data.status === 'pending') {
          renderRedditPanelLoading(Math.floor((Date.now() - startedAt) / 1000));
          await sleep(3000);
          continue;
        }
        renderRedditPanel(data);
        return;
      } catch (error) {
        renderRedditPanelError(error instanceof Error ? error.message : 'Could not load Reddit discussions.');
        return;
      }
    }
    renderRedditPanelError('Reddit discovery took too long. Re-run the scan to try again.');
  }


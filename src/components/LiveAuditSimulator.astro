    renderTechPanel(websiteUrl, results);
    renderDemoPanels(websiteUrl);
    if (progressBox) progressBox.classList.add('hidden');
    if (resultsBox) resultsBox.classList.remove('hidden');
  }

  async function pollCrawl(crawlId: string): Promise<void> {
    const deadline = Date.now() + 120000;
    while (Date.now() < deadline) {
      const res = await apiFetch(`/api/crawls/${crawlId}`);
      if (!res.ok) throw await backendError(res);
      const run = await res.json();
      if (run.status === 'COMPLETED') return;
      if (run.status === 'FAILED') {
        throw new Error(run.errorMessage || 'The crawl failed — no pages could be fetched.');
      }
      await sleep(1500);
    }
    throw new Error('Scan timed out. The website took too long to crawl.');
  }

  async function renderCrawlResults(crawlId: string, websiteUrl: string, projectId: string, scrollToHistory = false) {
    showProgress('Analyzing technical SEO signals...', 'Computing the health score from collected data', 85);
    const resultsRes = await apiFetch(`/api/crawls/${crawlId}/results`);
    if (!resultsRes.ok) throw await backendError(resultsRes);
    const results = await resultsRes.json();

    showResults(websiteUrl, results);

    renderSearchPanelLoading();
    try {
      const searchRes = await apiFetch(`/api/crawls/${crawlId}/search-opportunities`);
      if (!searchRes.ok) throw await backendError(searchRes);
      renderSearchPanel(await searchRes.json());
    } catch (error) {
      renderSearchPanelError(error instanceof Error ? error.message : 'Could not load search opportunities.');
    }

    await loadRedditPanel(crawlId);

    renderAiPanelLoading();
    try {
      const aiRes = await apiFetch(`/api/crawls/${crawlId}/ai-visibility`);
      if (!aiRes.ok) throw await backendError(aiRes);
      renderAiPanel(await aiRes.json());
    } catch (error) {
      renderAiPanelError(error instanceof Error ? error.message : 'Could not load AI visibility results.');
    }

    renderContentPanelLoading();
    try {
      const contentRes = await apiFetch(`/api/crawls/${crawlId}/content-recommendations`);
      if (!contentRes.ok) throw await backendError(contentRes);
      const contentData = await contentRes.json();
      renderContentPanel(contentData);
      updateNextActionFromContent(contentData);
    } catch (error) {
      renderContentPanelError(error instanceof Error ? error.message : 'Could not load content recommendations.');
    }

    await loadScanHistory(projectId, crawlId);
    if (scrollToHistory) {
      const historySection = document.getElementById('sim-history-section');
      if (historySection) historySection.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }

  function showEmptyScanState(websiteUrl: string) {
    const displayDomain = websiteUrl.replace(/^https?:\/\//, '');
    if (resDomain) resDomain.textContent = displayDomain;
    if (resScore) resScore.innerHTML = `-- <span class="text-sm font-normal text-slate-400">/ 100</span>`;
    if (techStatus) techStatus.textContent = 'No scans yet';
    if (techItems) techItems.innerHTML = '<div class="text-slate-400">Run a new scan to audit this project.</div>';
    if (searchStatus) searchStatus.textContent = 'Awaiting scan';
    if (searchItems) searchItems.innerHTML = '<div class="text-slate-400">Run a scan to discover real search opportunities.</div>';
    if (redditStatus) redditStatus.textContent = 'Awaiting scan';
    if (redditItems) redditItems.innerHTML = '<div class="text-slate-400">Run a scan to look for relevant Reddit discussions.</div>';
    if (aiStatus) aiStatus.textContent = 'Awaiting scan';
    if (aiItems) aiItems.innerHTML = '<div class="text-slate-400">Run a scan to check your AI engine footprint.</div>';
    if (contentStatus) contentStatus.textContent = 'Awaiting scan';
    if (contentItems) contentItems.innerHTML = '<div class="text-slate-400">Run a scan to generate content recommendations.</div>';
    const historySection = document.getElementById('sim-history-section');
    if (historySection) historySection.classList.add('hidden');
    if (progressBox) progressBox.classList.add('hidden');
    if (resultsBox) resultsBox.classList.remove('hidden');
  }

  function renderTeaserDemo(rawDomain: string) {
    const cleanDomain = domainKey(rawDomain);
    const persona = personaDatabase[cleanDomain] || fallbackPersona(cleanDomain);
    if (resDomain) resDomain.textContent = cleanDomain || 'mycustomsite.com';
    if (resScore) resScore.innerHTML = `${persona.score} <span class="text-sm font-normal text-slate-400">/ 100</span>`;
    if (techStatus) techStatus.textContent = persona.techStatus;
    if (techItems) {
      techItems.innerHTML = persona.techItems.map(line => {
        const isGood = line.startsWith('✓');
        return `<div class="flex items-center gap-1.5 ${isGood ? 'text-emerald-700' : 'text-amber-700'}">${escapeHtml(line)}</div>`;
      }).join('');
    }
    if (nextAction) nextAction.textContent = persona.nextAction;
    if (searchStatus) searchStatus.textContent = 'Sample preview';
    if (searchItems) searchItems.innerHTML = '<div class="text-slate-400">Log in to run a real crawl and discover search opportunities.</div>';
    if (redditStatus) redditStatus.textContent = 'Sample preview';
    if (redditItems) redditItems.innerHTML = '<div class="text-slate-400">Log in to see real Reddit discussions for this niche.</div>';
    if (aiStatus) aiStatus.textContent = 'Sample preview';
    if (aiItems) aiItems.innerHTML = '<div class="text-slate-400">Log in to measure real AI citations for this site.</div>';
    if (contentStatus) contentStatus.textContent = 'Sample preview';
    if (contentItems) contentItems.innerHTML = '<div class="text-slate-400">Log in to generate content recommendations.</div>';
    const historySection = document.getElementById('sim-history-section');
    if (historySection) historySection.classList.add('hidden');
    if (progressBox) progressBox.classList.add('hidden');
    if (resultsBox) resultsBox.classList.remove('hidden');
  }

  function redirectToAuth(websiteUrl: string) {
    const params = new URLSearchParams({ next: '/app' });
    params.set('website', websiteUrl.replace(/^https?:\/\//, ''));
    window.location.href = `/login?${params.toString()}`;
  }

  async function runRealScan(rawDomain: string) {
    const websiteUrl = toWebsiteUrl(rawDomain);
    if (!websiteUrl) {
      showError('Please enter a website URL.');
      return;
    }
    if (SIM_MODE === 'teaser' && !currentUser) {
      redirectToAuth(websiteUrl);
      return;
    }
    let projectId = SIM_MODE === 'app' ? selectedProjectId : '';
    if (SIM_MODE === 'app' && !projectId) {
      showError('Select a project first.');
      return;
    }
    const targetUrl = projectId && projectCache[projectId]?.websiteUrl ? projectCache[projectId].websiteUrl : websiteUrl;
    if (runBtn) {
      runBtn.disabled = true;
      runBtn.classList.add('opacity-60', 'cursor-wait');
    }
    showProgress('Preparing scan...', 'Connecting to the SEO backend');
    try {
      if (!projectId) {
        // Teaser mode: create the project, or reuse an existing one for the same website URL.
        const projectRes = await apiFetch('/api/projects', {
          method: 'POST',
          body: JSON.stringify({ name: websiteUrl, websiteUrl }),
        });
        if (projectRes.status === 409) {
          showProgress('Preparing scan...', 'Reusing the existing project for this website');
          const resolveRes = await apiFetch(`/api/projects/resolve?websiteUrl=${encodeURIComponent(websiteUrl)}`);
          if (!resolveRes.ok) throw await backendError(resolveRes);
          projectId = (await resolveRes.json()).id;
        } else if (projectRes.ok) {
          projectId = (await projectRes.json()).id;
        } else {
          throw await backendError(projectRes);
        }
        await loadProjects();
      }

      showProgress('Starting crawl...', 'Discovering pages, robots.txt and sitemap', 30);
      const crawlRes = await apiFetch(`/api/projects/${projectId}/crawls`, { method: 'POST' });
      if (!crawlRes.ok) throw await backendError(crawlRes);
      const crawl = await crawlRes.json();

      showProgress('Scanning website infrastructure...', 'Crawling internal pages within the domain', 45);
      await pollCrawl(crawl.id);

      await renderCrawlResults(crawl.id, targetUrl, projectId);
      await loadProjects();
    } catch (error) {
      showError(error instanceof Error ? error.message : 'Scan failed unexpectedly.');
    } finally {
      if (runBtn) {
        runBtn.disabled = false;
        runBtn.classList.remove('opacity-60', 'cursor-wait');
      }
      window.dispatchEvent(new CustomEvent('foundable:scan-complete', { detail: { projectId } }));
    }
  }

  async function loadProjectResults(projectId: string, action: 'results' | 'history') {
    try {
      const projectRes = await apiFetch(`/api/projects/${projectId}`);
      if (!projectRes.ok) throw await backendError(projectRes);
      const project = await projectRes.json();
      const historyRes = await apiFetch(`/api/projects/${projectId}/scans`);
      if (!historyRes.ok) throw await backendError(historyRes);
      const history = await historyRes.json();
      const latest = history.scans?.[0];
      if (!latest) {
        showEmptyScanState(project.websiteUrl);
        return;
      }
      await renderCrawlResults(latest.id, project.websiteUrl, projectId, action === 'history');
    } catch (error) {
      showError(error instanceof Error ? error.message : 'Could not load results.');
    }
  }

  // --- Session & project ownership (driven by the app shell / event bus) ---
  let currentUser: { id: string; email: string } | null = null;
  let selectedProjectId = '';
  const projectCache: Record<string, { domain: string; websiteUrl: string }> = {};
  const projectSelect = document.getElementById('sim-project-select') as HTMLSelectElement | null;

  function updateProjectMeta(domain: string) {
    if (!appProjectMeta) return;
    appProjectMeta.textContent = `Current project: ${domain}`;
  }

  async function checkSession() {
    try {
      const res = await apiFetch('/api/auth/me');
      if (res.ok) currentUser = (await res.json()).user;
    } catch {
      // Backend offline; teaser mode will redirect to auth on scan attempts.
    }
  }

  async function loadProjects() {
    if (!projectSelect) return;
    const previous = selectedProjectId;
    projectSelect.innerHTML = '';
    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = 'Select a project...';
    projectSelect.appendChild(placeholder);
    try {
      const res = await apiFetch('/api/projects');
      if (!res.ok) throw await backendError(res);
      const data = await res.json();
      for (const project of data.projects ?? []) {
        const option = document.createElement('option');
        option.value = project.id;
        option.textContent = project.domain;
        projectSelect.appendChild(option);
        projectCache[project.id] = { domain: project.domain, websiteUrl: project.websiteUrl };
      }
      selectedProjectId = previous;
      if (projectSelect.value !== selectedProjectId) projectSelect.value = selectedProjectId;
      if (selectedProjectId && projectCache[selectedProjectId]) {
        updateProjectMeta(projectCache[selectedProjectId].domain);
      }
    } catch {
      // The dashboard owns error messaging; fail silently here.
    }
  }

  projectSelect?.addEventListener('change', () => {
    selectedProjectId = projectSelect.value;
    if (selectedProjectId && projectCache[selectedProjectId]) {
      updateProjectMeta(projectCache[selectedProjectId].domain);
      void loadProjectResults(selectedProjectId, 'results');
    }
  });

  // The app shell (src/pages/app.astro) drives project selection via this event.
  window.addEventListener('foundable:select-project', (event) => {
    const detail = (event as CustomEvent<{ id: string; domain: string; websiteUrl: string; action?: string }>).detail;
    if (!detail?.id) return;
    selectedProjectId = detail.id;
    projectCache[detail.id] = { domain: detail.domain, websiteUrl: detail.websiteUrl };
    if (projectSelect) {
      projectSelect.value = detail.id;
    }
    updateProjectMeta(detail.domain);
    const action = detail.action ?? 'results';
    if (action === 'scan') {
      void runRealScan(detail.domain);
    } else {
      void loadProjectResults(detail.id, action === 'history' ? 'history' : 'results');
    }
  });

  void checkSession();
  if (SIM_MODE === 'app') {
    void loadProjects();
  }

  personaBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      personaBtns.forEach(b => {
        b.className = 'sim-persona-btn px-3 py-1.5 rounded-lg bg-white text-slate-700 hover:bg-slate-100 border border-slate-200 text-xs font-semibold cursor-pointer transition-all';
      });
      btn.className = 'sim-persona-btn active px-3 py-1.5 rounded-lg bg-[#0c1021] text-white text-xs font-semibold cursor-pointer transition-all';

      const domain = btn.getAttribute('data-domain') || 'resumeforge.io';
      if (domainInput) domainInput.value = domain;
      renderTeaserDemo(domain);
    });
  });

  if (runBtn) {
    runBtn.addEventListener('click', () => {
      const domain = domainInput ? domainInput.value.trim() : (projectCache[selectedProjectId]?.domain ?? '');
      void runRealScan(domain);
    });
  }
</script>

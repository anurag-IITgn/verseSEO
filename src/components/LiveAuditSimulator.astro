  // Scan History & Previous Scan is driven by the real scan-history and
  // comparison endpoints. All values come from persisted scans — nothing is
  // fabricated when there is no previous scan yet.
  function scanDate(iso: string): string {
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return '—';
    return `${d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' })} · ${d.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' })}`;
  }

  function renderScanHistoryPanel(
    history: { total: number; scans: Array<{ id: string; completedAt: string | null; createdAt: string; healthScore: number | null }> },
    comp: {
      hasPrevious: boolean;
      message: string | null;
      current: {
        id: string;
        completedAt: string | null;
        createdAt: string;
        healthScore: number | null;
        pagesCrawled: number;
        results: { issueCount: number };
      } | null;
      previous: {
        completedAt: string | null;
        createdAt: string;
        healthScore: number | null;
        pagesCrawled: number;
        results: { issueCount: number };
      } | null;
      changes: { healthScore: { from: number; to: number; delta: number } | null } | null;
      improvements: string[];
      regressions: string[];
    },
    crawlId: string,
  ) {
    const body = document.getElementById('sim-history-body');
    const count = document.getElementById('sim-history-count');
    if (!body || !count) return;

    const current = comp.current;
    if (!current) {
      count.textContent = '';
      body.innerHTML = '<div class="text-slate-400">No completed scans available yet.</div>';
      return;
    }

    count.textContent = `${history.total} scan${history.total === 1 ? '' : 's'}`;
    const prev = comp.previous;
    let html = '';

    if (!prev) {
      html = `
        <div class="flex items-center gap-2 text-amber-700">
          <span>ⓘ</span><span>${escapeHtml(comp.message ?? 'No previous scan available yet.')}</span>
        </div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
          <span class="text-slate-500">Current scan:</span>
          <span class="font-bold text-slate-800">${escapeHtml(scanDate(current.completedAt ?? current.createdAt))}</span>
          <span class="text-slate-500">Health:</span>
          <span class="font-bold text-slate-800">${current.healthScore ?? '—'}/100</span>
        </div>
      `;
    } else {
      const scoreDelta = comp.changes?.healthScore?.delta ?? 0;
      const deltaClass = scoreDelta > 0 ? 'text-emerald-700' : scoreDelta < 0 ? 'text-rose-600' : 'text-slate-500';
      const deltaText = scoreDelta > 0 ? `+${scoreDelta}` : `${scoreDelta}`;
      html = `
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="p-2.5 rounded-lg border border-slate-200 bg-white space-y-0.5">
            <span class="text-[10px] font-bold uppercase tracking-wide text-blue-700">Current scan</span>
            <div class="text-slate-700">${escapeHtml(scanDate(current.completedAt ?? current.createdAt))}</div>
            <div class="text-slate-500">Health <span class="font-bold text-slate-800">${current.healthScore ?? '—'}/100</span></div>
          </div>
          <div class="p-2.5 rounded-lg border border-slate-200 bg-white space-y-0.5">
            <span class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Previous scan</span>
            <div class="text-slate-700">${escapeHtml(scanDate(prev.completedAt ?? prev.createdAt))}</div>
            <div class="text-slate-500">Health <span class="font-bold text-slate-800">${prev.healthScore ?? '—'}/100</span></div>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-slate-500">Score change:</span>
          <span class="font-bold ${deltaClass}">${escapeHtml(deltaText)}</span>
          <span class="text-slate-400 text-[11px]">(${prev.healthScore ?? '—'} → ${current.healthScore ?? '—'})</span>
        </div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
          <span class="text-slate-500">Pages:</span>
          <span class="text-slate-700">${prev.pagesCrawled} → ${current.pagesCrawled}</span>
          <span class="text-slate-500">Issues:</span>
          <span class="text-slate-700">${prev.results.issueCount} → ${current.results.issueCount}</span>
        </div>
        ${comp.improvements.length > 0
          ? `<div class="space-y-0.5"><div class="text-[10px] font-bold uppercase tracking-wide text-emerald-700">Improvements</div>${comp.improvements.map((i: string) => `<div class="text-emerald-700 flex gap-1.5"><span>✓</span><span>${escapeHtml(i)}</span></div>`).join('')}</div>`
          : ''}
        ${comp.regressions.length > 0
          ? `<div class="space-y-0.5"><div class="text-[10px] font-bold uppercase tracking-wide text-rose-600">Regressions</div>${comp.regressions.map((i: string) => `<div class="text-rose-600 flex gap-1.5"><span>✕</span><span>${escapeHtml(i)}</span></div>`).join('')}</div>`
          : ''}
      `;
    }

    const chips = history.scans.map((s) => {
      const isCurrent = s.id === crawlId;
      return `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md border text-[10px] font-mono ${isCurrent ? 'bg-blue-50 border-blue-200 text-blue-800' : 'bg-white border-slate-200 text-slate-600'}">${escapeHtml(scanDate(s.completedAt ?? s.createdAt))} · ${s.healthScore ?? '—'}</span>`;
    }).join('');
    html += `<div class="pt-1"><span class="text-[10px] font-bold uppercase tracking-wide text-slate-500">All scans</span><div class="flex flex-wrap gap-1.5 mt-1">${chips}</div></div>`;

    body.innerHTML = html;
  }

  async function loadScanHistory(projectId: string, crawlId: string) {
    const historySection = document.getElementById('sim-history-section');
    if (!historySection) return;
    try {
      const [historyRes, compRes] = await Promise.all([
        apiFetch(`/api/projects/${projectId}/scans`),
        apiFetch(`/api/projects/${projectId}/scans/comparison`),
      ]);
      if (!historyRes.ok) throw await backendError(historyRes);
      if (!compRes.ok) throw await backendError(compRes);
      const history = await historyRes.json();
      const comp = await compRes.json();
      renderScanHistoryPanel(history, comp, crawlId);
      historySection.classList.remove('hidden');
    } catch {
      historySection.classList.add('hidden');
    }
  }

  function showProgress(title: string, subtitle: string, width = 15) {
    if (!progressBox || !resultsBox || !progressBar) return;
    resultsBox.classList.add('hidden');
    progressBox.classList.remove('hidden');
    progressBar.classList.remove('bg-rose-600');
    progressBar.classList.add('bg-blue-600');
    progressBar.style.width = `${width}%`;
    if (progressTitle) progressTitle.textContent = title;
    if (progressSubtitle) progressSubtitle.textContent = subtitle;
  }

  function showError(message: string) {
    if (!progressBox || !resultsBox || !progressBar) return;
    resultsBox.classList.add('hidden');
    progressBox.classList.remove('hidden');
    progressBar.classList.remove('bg-blue-600');
    progressBar.classList.add('bg-rose-600');
    progressBar.style.width = '100%';
    if (progressTitle) progressTitle.textContent = 'Scan Failed';
    if (progressSubtitle) progressSubtitle.textContent = message;
  }


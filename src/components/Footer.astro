---
// Footer.astro
---

<footer class="bg-[#0c1021] text-slate-400 text-xs sm:text-sm border-t border-white/5 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Row: Brand & Newsletter -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 pb-12 border-b border-slate-800/80">
      
      <!-- Brand column -->
      <div class="lg:col-span-5 space-y-4">
        <a href="/" class="flex items-center gap-2.5">
          <img src="/brand/logo-mark-new.png" alt="VerseSEO icon" class="w-8 h-8 rounded-xl object-cover" />
          <span class="font-extrabold text-xl tracking-tight text-white">VerseSEO</span>
        </a>
        <p class="text-xs sm:text-sm text-slate-400 max-w-sm leading-relaxed">
          Lightweight SEO, Reddit opportunity discovery, and AI answer engine intelligence for small businesses, SaaS founders, and creators.
        </p>
        <div class="flex items-center gap-2 pt-2">
          <span class="flex h-2 w-2 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="text-xs text-slate-400 font-mono">All audit engines operational</span>
        </div>
      </div>

      <!-- Newsletter subscription -->
      <div class="lg:col-span-7 bg-[#141929] p-6 rounded-2xl border border-white/5 space-y-3">
        <div class="text-sm font-bold text-white">Get weekly AI & SEO intelligence updates</div>
        <p class="text-xs text-slate-400">
          Join 2,400+ founders learning how to get cited in ChatGPT and rank on Google with zero spam.
        </p>
        <form id="newsletter-form" class="flex flex-col sm:flex-row gap-2">
          <input 
            type="email" 
            id="newsletter-email"
            placeholder="Enter your email address" 
            class="w-full px-3.5 py-2 rounded-xl bg-[#0c1021] border border-white/10 text-white placeholder:text-slate-500 text-xs focus:outline-none focus:border-blue-500"
            required
          />
          <button 
            type="submit" 
            id="newsletter-submit"
            class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl shrink-0 transition-colors cursor-pointer"
          >
            Subscribe
          </button>
        </form>
        <div id="newsletter-success" class="hidden text-xs text-emerald-400 font-medium pt-1">
          You're subscribed!
        </div>
      </div>

      <script>
        const API_BASE = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:3000';
        const form = document.getElementById('newsletter-form') as HTMLFormElement;
        const emailInput = document.getElementById('newsletter-email') as HTMLInputElement;
        const submitBtn = document.getElementById('newsletter-submit') as HTMLButtonElement;
        const successMsg = document.getElementById('newsletter-success');

        form?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const email = emailInput.value.trim();
          if (!email) return;

          submitBtn.disabled = true;
          submitBtn.textContent = 'Subscribing...';

          try {
            const res = await fetch(`${API_BASE}/api/newsletter/subscribe`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email }),
            });

            if (res.ok) {
              form.classList.add('hidden');
              successMsg?.classList.remove('hidden');
            } else {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Subscribe';
            }
          } catch {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Subscribe';
          }
        });
      </script>

    </div>

    <!-- Navigation Directory Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 py-12 border-b border-slate-800/80">
      
      <!-- Col 1: Product -->
      <div class="space-y-3">
        <div class="text-xs font-bold uppercase tracking-wider text-white font-mono">Product Modules</div>
        <ul class="space-y-2 text-xs">
          <li><a href="#modules" class="hover:text-white transition-colors">Technical Website Health</a></li>
          <li><a href="#modules" class="hover:text-white transition-colors">Search & Intent Discovery</a></li>
          <li><a href="#modules" class="hover:text-white transition-colors">Reddit Opportunity Listening</a></li>
          <li><a href="#modules" class="hover:text-white transition-colors">AI & LLM Visibility Radar</a></li>
          <li><a href="#modules" class="hover:text-white transition-colors">Content Generator & Briefs</a></li>
          <li><a href="#demo" class="hover:text-white transition-colors text-blue-400 font-semibold">Live Microtool Simulator</a></li>
        </ul>
      </div>

      <!-- Col 2: Resources -->
      <div class="space-y-3">
        <div class="text-xs font-bold uppercase tracking-wider text-white font-mono">Resources</div>
        <ul class="space-y-2 text-xs">
          <li><a href="#workflow" class="hover:text-white transition-colors">How Discovery Works</a></li>
          <li><a href="#discovery-shift" class="hover:text-white transition-colors">The 2026 Search Shift</a></li>
          <li><a href="#pricing" class="hover:text-white transition-colors">Pricing Calculator</a></li>
          <li><a href="#faq" class="hover:text-white transition-colors">Knowledge Base & FAQ</a></li>
          <li><a href="#" onclick="alert('Changelog will be published with V1 release!')" class="hover:text-white transition-colors">Product Changelog</a></li>
        </ul>
      </div>

      <!-- Col 3: Company -->
      <div class="space-y-3">
        <div class="text-xs font-bold uppercase tracking-wider text-white font-mono">Company</div>
        <ul class="space-y-2 text-xs">
          <li><a href="#" onclick="alert('VerseSEO is designed by indie builders for small businesses.')" class="hover:text-white transition-colors">About Us</a></li>
          <li><a href="#" onclick="alert('Our zero-spam policy protects Reddit and search community integrity.')" class="hover:text-white transition-colors">Zero-Spam Pledge</a></li>
          <li><a href="#" onclick="alert('VerseSEO roadmap will be available on GitHub & public board.')" class="hover:text-white transition-colors">Public Roadmap</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Contact Support</a></li>
        </ul>
      </div>

      <!-- Col 4: Legal & Compliance -->
      <div class="space-y-3">
        <div class="text-xs font-bold uppercase tracking-wider text-white font-mono">Legal</div>
        <ul class="space-y-2 text-xs">
          <li><a href="#" onclick="alert('Privacy Policy: We do not sell user search or crawl queries to third parties.')" class="hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="#" onclick="alert('Terms of Service: Standard SaaS terms apply.')" class="hover:text-white transition-colors">Terms of Service</a></li>
          <li><a href="#" onclick="alert('Security: Standard TLS 1.3 encryption and secure headers implemented.')" class="hover:text-white transition-colors">Security Overview</a></li>
          <li><a href="#" onclick="alert('Cookie settings: Minimal essential analytics cookies only.')" class="hover:text-white transition-colors">Cookie Preferences</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div>
        © {new Date().getFullYear()} VerseSEO Inc. All rights reserved. Simple, actionable visibility intelligence.
      </div>
      <div class="flex items-center gap-4 text-slate-400">
        <a href="https://www.instagram.com/verseseo" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors" aria-label="Instagram">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
        <a href="https://x.com/Verseseo_AI" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors" aria-label="X / Twitter">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="https://github.com/anurag-IITgn/verseSEO" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors" aria-label="GitHub">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        </a>
      </div>
    </div>

  </div>
</footer>

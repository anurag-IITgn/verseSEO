---
// Footer.astro
---

<footer class="bg-[#0c1021] text-slate-400 text-xs sm:text-sm border-t border-white/5 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Row: Brand & Newsletter -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 pb-12 border-b border-slate-800/80">
      
      <!-- Brand column -->
      <div class="lg:col-span-5 space-y-4">
        <a href="/" class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-blue-700 via-indigo-600 to-violet-500 flex items-center justify-center text-white font-bold">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 3v18"></path>
              <path d="M3 12h18"></path>
            </svg>
          </div>
          <span class="font-extrabold text-xl tracking-tight text-white">VerseSEO</span>
        </a>
        <p class="text-xs sm:text-sm text-slate-400 max-w-sm leading-relaxed">
          Lightweight SEO, Reddit opportunity discovery, and AI answer engine intelligence for small businesses, SaaS founders, and creators.
        </p>
        <div class="flex items-center gap-2 pt-2">
          <span class="flex h-2 w-2 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="text-xs text-slate-400 font-mono">All audit engines operational</span>
        </div>
      </div>

      <!-- Newsletter subscription -->
      <div class="lg:col-span-7 bg-[#141929] p-6 rounded-2xl border border-white/5 space-y-3">
        <div class="text-sm font-bold text-white">Get weekly AI & SEO intelligence updates</div>
        <p class="text-xs text-slate-400">
          Join 2,400+ founders learning how to get cited in ChatGPT and rank on Google with zero spam.
        </p>
        <form class="flex flex-col sm:flex-row gap-2" onsubmit="event.preventDefault(); alert('Thank you for subscribing to the VerseSEO visibility newsletter!');">
          <input 
            type="email" 
            placeholder="Enter your email address" 
            class="w-full px-3.5 py-2 rounded-xl bg-[#0c1021] border border-white/10 text-white placeholder:text-slate-500 text-xs focus:outline-none focus:border-blue-500"
            required
          />
          <button 
            type="submit" 
            class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl shrink-0 transition-colors cursor-pointer"
          >
            Subscribe
          </button>
        </form>
      </div>

    </div>

    <!-- Navigation Directory Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 py-12 border-b border-slate-800/80">
      
      <!-- Col 1: Product -->
      <div class="space-y-3">
        <div class="text-xs font-bold uppercase tracking-wider text-white font-mono">Product Modules</div>
        <ul class="space-y-2 text-xs">
          <li><a href="#modules" class="hover:text-white transition-colors">Technical Website Health</a></li>
          <li><a href="#modules" class="hover:text-white transition-colors">Search & Intent Discovery</a></li>
          <li><a href="#modules" class="hover:text-white transition-colors">Reddit Opportunity Listening</a></li>
          <li><a href="#modules" class="hover:text-white transition-colors">AI & LLM Visibility Radar</a></li>
          <li><a href="#modules" class="hover:text-white transition-colors">Content Generator & Briefs</a></li>
          <li><a href="#demo" class="hover:text-white transition-colors text-blue-400 font-semibold">Live Microtool Simulator</a></li>
        </ul>
      </div>

      <!-- Col 2: Resources -->
      <div class="space-y-3">
        <div class="text-xs font-bold uppercase tracking-wider text-white font-mono">Resources</div>
        <ul class="space-y-2 text-xs">
          <li><a href="#workflow" class="hover:text-white transition-colors">How Discovery Works</a></li>
          <li><a href="#discovery-shift" class="hover:text-white transition-colors">The 2026 Search Shift</a></li>
          <li><a href="#pricing" class="hover:text-white transition-colors">Pricing Calculator</a></li>
          <li><a href="#faq" class="hover:text-white transition-colors">Knowledge Base & FAQ</a></li>
          <li><a href="#" onclick="alert('Changelog will be published with V1 release!')" class="hover:text-white transition-colors">Product Changelog</a></li>
        </ul>
      </div>

      <!-- Col 3: Company -->
      <div class="space-y-3">
        <div class="text-xs font-bold uppercase tracking-wider text-white font-mono">Company</div>
        <ul class="space-y-2 text-xs">
          <li><a href="#" onclick="alert('VerseSEO is designed by indie builders for small businesses.')" class="hover:text-white transition-colors">About Us</a></li>
          <li><a href="#" onclick="alert('Our zero-spam policy protects Reddit and search community integrity.')" class="hover:text-white transition-colors">Zero-Spam Pledge</a></li>
          <li><a href="#" onclick="alert('VerseSEO roadmap will be available on GitHub & public board.')" class="hover:text-white transition-colors">Public Roadmap</a></li>
          <li><a href="#" onclick="alert('Contact support via email at support@verseseo.com')" class="hover:text-white transition-colors">Contact Support</a></li>
        </ul>
      </div>

      <!-- Col 4: Legal & Compliance -->
      <div class="space-y-3">
        <div class="text-xs font-bold uppercase tracking-wider text-white font-mono">Legal</div>
        <ul class="space-y-2 text-xs">
          <li><a href="#" onclick="alert('Privacy Policy: We do not sell user search or crawl queries to third parties.')" class="hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="#" onclick="alert('Terms of Service: Standard SaaS terms apply.')" class="hover:text-white transition-colors">Terms of Service</a></li>
          <li><a href="#" onclick="alert('Security: Standard TLS 1.3 encryption and secure headers implemented.')" class="hover:text-white transition-colors">Security Overview</a></li>
          <li><a href="#" onclick="alert('Cookie settings: Minimal essential analytics cookies only.')" class="hover:text-white transition-colors">Cookie Preferences</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div>
        © {new Date().getFullYear()} VerseSEO Inc. All rights reserved. Simple, actionable visibility intelligence.
      </div>
      <div class="flex items-center gap-4 text-slate-400">
        <span class="hover:text-white cursor-pointer" onclick="alert('Twitter / X handle: @VerseSEO')">Twitter / X</span>
        <span>•</span>
        <span class="hover:text-white cursor-pointer" onclick="alert('Discord community opening soon!')">Discord</span>
        <span>•</span>
        <span class="hover:text-white cursor-pointer" onclick="alert('GitHub repo for open-source widgets: github.com/verseseo')">GitHub</span>
      </div>
    </div>

  </div>
</footer>

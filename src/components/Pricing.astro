---
// Pricing.astro — Final two-plan pricing (Free + Pro)
---

<section class="py-16 sm:py-24 bg-[#f5f4f0] border-b border-slate-200/80 relative" id="pricing">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-200/60 text-xs font-bold text-blue-700 uppercase tracking-wider mb-3">
        Transparent Pricing
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Simple plans for every growth stage.
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
        Start free to uncover your website's baseline visibility. Upgrade as you scale your search rankings and AI citations.
      </p>
    </div>

    <!-- Pricing Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch max-w-5xl mx-auto">
      
      <!-- Tier 1: Free -->
      <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-xs flex flex-col justify-between hover:border-slate-300 transition-all">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500 font-mono">Free</span>
            <span class="px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 text-xs font-bold">Free Forever</span>
          </div>

          <div class="mb-4">
            <div class="text-4xl font-extrabold text-slate-900">$0</div>
            <div class="text-xs text-slate-500 mt-1">No credit card required</div>
          </div>

          <p class="text-xs sm:text-sm text-slate-600 mb-6 leading-relaxed">
            Essential website intelligence for testing and improving your site's visibility.
          </p>

          <!-- Feature List -->
          <div class="space-y-3 pt-4 border-t border-slate-100 text-xs sm:text-sm text-slate-700">
            <div class="flex items-center gap-2.5">
              <span class="text-emerald-600 font-bold">✓</span>
              <span>1 project</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-emerald-600 font-bold">✓</span>
              <span>1 website scan — lifetime</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-emerald-600 font-bold">✓</span>
              <span>Technical Health</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-emerald-600 font-bold">✓</span>
              <span>Search Opportunities</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-emerald-600 font-bold">✓</span>
              <span>AI Engine Footprint — limited</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-emerald-600 font-bold">✓</span>
              <span>Content Opportunities — limited</span>
            </div>
            <div class="flex items-center gap-2.5 text-slate-400">
              <span>✕</span>
              <span>Reddit Intelligence</span>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-slate-100">
          <button 
            type="button" 
            class="pricing-cta w-full py-3 px-4 rounded-xl text-xs sm:text-sm font-bold bg-slate-100 hover:bg-slate-200 text-slate-800 transition-colors cursor-pointer"
            data-plan="free"
          >
            Start Free
          </button>
        </div>
      </div>

      <!-- Tier 2: Pro (Featured) -->
      <div class="bg-white rounded-3xl border-2 border-blue-600 p-6 sm:p-8 shadow-xl shadow-blue-600/10 flex flex-col justify-between relative">
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-blue-600 text-white text-[11px] font-extrabold uppercase tracking-wider px-3.5 py-1 rounded-full shadow-sm">
          Most Popular
        </div>

        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold uppercase tracking-wider text-blue-600 font-mono">Pro</span>
            <span class="px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-700 text-xs font-bold border border-blue-100">Most Popular</span>
          </div>

          <div class="mb-4">
            <div class="flex items-baseline gap-1">
              <span class="text-4xl font-extrabold text-slate-900">$24</span>
              <span class="text-xs text-slate-500 font-medium">/ month</span>
            </div>
            <div class="text-xs text-slate-500 mt-1">Billed monthly</div>
          </div>

          <p class="text-xs sm:text-sm text-slate-600 mb-6 leading-relaxed">
            Complete actionable intelligence for founders and small teams growing organic discovery.
          </p>

          <!-- Feature List -->
          <div class="space-y-3 pt-4 border-t border-slate-100 text-xs sm:text-sm text-slate-700">
            <div class="flex items-center gap-2.5 font-semibold text-slate-900">
              <span class="text-blue-600 font-bold">✓</span>
              <span>3 projects</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-blue-600 font-bold">✓</span>
              <span>Full website intelligence</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-blue-600 font-bold">✓</span>
              <span>Full Technical Health</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-blue-600 font-bold">✓</span>
              <span>Full Search Opportunities</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-blue-600 font-bold">✓</span>
              <span>Full AI Engine Footprint</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-blue-600 font-bold">✓</span>
              <span>Full Content Opportunities</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-blue-600 font-bold">✓</span>
              <span>Reddit Intelligence</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-blue-600 font-bold">✓</span>
              <span>2 Reddit scans per week</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-blue-600 font-bold">✓</span>
              <span>8 Reddit scans per month</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-blue-600 font-bold">✓</span>
              <span>Full access to gated report content</span>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-slate-100">
          <button 
            type="button" 
            class="pricing-cta w-full py-3 px-4 rounded-xl text-xs sm:text-sm font-bold bg-blue-600 hover:bg-blue-700 text-white shadow-md shadow-blue-600/25 transition-all cursor-pointer"
            data-plan="pro"
          >
            Get Started with Pro
          </button>
        </div>
      </div>

    </div>

    <!-- Pricing Note -->
    <div class="mt-12 text-center text-xs text-slate-500 max-w-2xl mx-auto">
      * Free plan requires no credit card. Pro pricing is per account, not per project. Need custom high-volume crawling? <a href="#faq" class="text-blue-600 underline font-medium">Contact our team</a>.
    </div>

  </div>
</section>

<script>
  const API = (import.meta as any).env?.PUBLIC_API_BASE_URL ?? 'http://localhost:3000';

  async function getCurrentUser(): Promise<{ id: string; email: string; plan: string } | null> {
    try {
      const res = await fetch(`${API}/api/auth/me`, { credentials: 'include' });
      if (res.ok) {
        const data = await res.json();
        return data.user ?? null;
      }
    } catch {}
    return null;
  }

  async function initPricingCtas() {
    const user = await getCurrentUser();
    const buttons = document.querySelectorAll<HTMLButtonElement>('.pricing-cta');

    buttons.forEach(btn => {
      const plan = btn.dataset.plan;
      btn.addEventListener('click', async () => {
        if (plan === 'free') {
          if (user) {
            // Already logged in — go to dashboard
            window.location.href = '/app';
          } else {
            // Not logged in — go to signup
            window.location.href = '/register?next=/app';
          }
        } else if (plan === 'pro') {
          if (!user) {
            // Not logged in — go to signup
            window.location.href = '/register?next=/app';
          } else if (user.plan === 'pro') {
            // Already Pro — go to settings
            window.location.href = '/app';
          } else {
            // Free user — create Dodo checkout session
            try {
              btn.disabled = true;
              btn.textContent = 'Opening checkout...';

              const res = await fetch(`${API}/api/billing/checkout`, {
                method: 'POST',
                credentials: 'include',
              });

              const data = await res.json();

              if (!res.ok || !data.checkoutUrl) {
                throw new Error(data.message || 'Unable to create checkout session');
              }

              window.location.href = data.checkoutUrl;
            } catch (error) {
              console.error('Checkout error:', error);
              btn.disabled = false;
              btn.textContent = 'Upgrade to Pro';
              alert('Unable to start checkout. Please try again.');
            }
          }
        }
      });

      // Update Pro button text if user is already Pro
      if (plan === 'pro' && user?.plan === 'pro') {
        btn.textContent = 'You\'re on Pro';
        btn.classList.remove('bg-blue-600', 'hover:bg-blue-700');
        btn.classList.add('bg-emerald-600', 'hover:bg-emerald-700');
      }
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initPricingCtas();
  });
</script>

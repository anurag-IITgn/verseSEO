---
// Hero.astro
import HeroProductVisual from './HeroProductVisual.astro';
---

<section class="relative pt-10 pb-16 sm:pt-16 sm:pb-24 lg:pt-20 lg:pb-32 overflow-hidden" id="hero-section">
  
  <!-- Subtle Background Gradients & Ambient Lighting (No harsh grids or cliches) -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-full overflow-hidden pointer-events-none -z-10">
    <div class="absolute top-0 left-1/4 w-[500px] h-[350px] bg-blue-400/10 rounded-full blur-3xl"></div>
    <div class="absolute top-12 right-1/4 w-[450px] h-[350px] bg-violet-400/10 rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <!-- Eyebrow Pill -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900/5 border border-slate-900/10 text-xs font-semibold text-slate-700 mb-6 hover:bg-slate-900/10 transition-colors">
      <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
      <span class="tracking-wide">SEO · AI VISIBILITY · REDDIT OPPORTUNITIES</span>
    </div>

    <!-- Main Dynamic Headline -->
    <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight text-slate-900 max-w-5xl mx-auto leading-[1.12] sm:leading-[1.1]">
      <span>Be the answer your customers find</span>
      <span class="block mt-1 sm:mt-2 min-h-[1.25em] flex items-center justify-center">
        <span 
          id="hero-dynamic-text" 
          class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 via-indigo-600 to-violet-700 transition-all duration-500 inline-block font-extrabold"
          style="filter: blur(0px); opacity: 1; transform: translateY(0);"
        >
          on Google
        </span>
      </span>
    </h1>

    <!-- Subheading -->
    <p class="mt-6 text-lg sm:text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
      The lightweight visibility intelligence platform for small businesses, founders, and creators. Fix technical roadblocks, discover high-intent search queries, tap into active Reddit discussions, and get cited by AI answer engines.
    </p>

    <!-- Interactive URL Audit Bar & CTAs -->
    <div class="mt-8 sm:mt-10 max-w-2xl mx-auto">
      
      <form id="hero-audit-form" class="flex flex-col sm:flex-row items-center gap-2 p-2 bg-white rounded-2xl border border-slate-300/80 shadow-lg shadow-slate-900/5 focus-within:border-blue-500 focus-within:ring-4 focus-within:ring-blue-500/10 transition-all">
        <div class="flex items-center gap-2.5 w-full px-3 py-1.5">
          <svg class="w-5 h-5 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
          </svg>
          <input 
            type="text" 
            id="hero-url-input"
            name="website" 
            placeholder="Enter your website (e.g. yourbrand.com)" 
            class="w-full text-sm sm:text-base text-slate-900 placeholder:text-slate-400 bg-transparent border-0 focus:outline-none focus:ring-0 font-medium"
            required
          />
        </div>
        
        <button 
          type="submit" 
          id="hero-submit-btn"
          class="w-full sm:w-auto shrink-0 inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-blue-600 hover:bg-blue-700 text-white text-sm sm:text-base font-semibold rounded-xl shadow-md shadow-blue-600/25 hover:shadow-lg hover:shadow-blue-600/35 transition-all duration-200 cursor-pointer"
        >
          <span>Analyze my website</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>
      </form>

      <!-- Preset Example Chips -->
      <div class="mt-3 flex flex-wrap items-center justify-center gap-2 text-xs text-slate-500">
        <span class="font-medium text-slate-400">Try demo presets:</span>
        <button type="button" class="hero-preset-chip px-2.5 py-1 rounded-md bg-slate-100/90 hover:bg-blue-50 hover:text-blue-700 border border-slate-200/80 font-mono transition-colors cursor-pointer" data-url="resumeforge.io">
          resumeforge.io
        </button>
        <button type="button" class="hero-preset-chip px-2.5 py-1 rounded-md bg-slate-100/90 hover:bg-blue-50 hover:text-blue-700 border border-slate-200/80 font-mono transition-colors cursor-pointer" data-url="notion.so">
          notion.so
        </button>
        <button type="button" class="hero-preset-chip px-2.5 py-1 rounded-md bg-slate-100/90 hover:bg-blue-50 hover:text-blue-700 border border-slate-200/80 font-mono transition-colors cursor-pointer" data-url="cal.com">
          cal.com
        </button>
      </div>

      <!-- Value Props Row -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-4 sm:gap-8 text-xs sm:text-sm font-medium text-slate-500">
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
          <span>No credit card required</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
          <span>Instant 30-second audit</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
          <span>5 connected modules</span>
        </div>
      </div>

    </div>

    <!-- Product Visualization Component -->
    <HeroProductVisual />

  </div>
</section>

<!-- Dynamic Headline Script synchronized with Hero Product Visual -->
<script>
  const phrases = [
    { text: "on Google", channelIndex: 0 },
    { text: "on Reddit", channelIndex: 1 },
    { text: "in ChatGPT", channelIndex: 2 },
    { text: "in Perplexity", channelIndex: 3 },
    { text: "through search", channelIndex: 0 },
    { text: "through content", channelIndex: 4 },
    { text: "everywhere.", channelIndex: 5 }
  ];

  let currentIndex = 0;
  let isPausedByUser = false;
  const headlineEl = document.getElementById('hero-dynamic-text');
  const tabs = document.querySelectorAll<HTMLButtonElement>('.hero-tab-btn');
  const panels = document.querySelectorAll<HTMLElement>('.hero-view-panel');
  const ambientGlow = document.getElementById('visual-ambient-glow');

  function switchView(index: number) {
    // Update Tab UI
    tabs.forEach((tab, i) => {
      const isSelected = i === index;
      tab.setAttribute('aria-selected', isSelected.toString());
      if (isSelected) {
        tab.className = 'hero-tab-btn px-2.5 sm:px-3 py-1.5 rounded-lg transition-all duration-200 text-slate-900 bg-white shadow-xs font-medium cursor-pointer';
      } else {
        tab.className = 'hero-tab-btn px-2.5 sm:px-3 py-1.5 rounded-lg transition-all duration-200 text-slate-600 hover:text-slate-900 font-medium cursor-pointer';
      }
    });

    // Update Panels
    panels.forEach((panel, i) => {
      if (i === index) {
        panel.classList.remove('hidden');
        setTimeout(() => {
          panel.classList.remove('opacity-0');
          panel.classList.add('opacity-100');
        }, 30);
      } else {
        panel.classList.remove('opacity-100');
        panel.classList.add('opacity-0');
        setTimeout(() => {
          if (panel.classList.contains('opacity-0')) {
            panel.classList.add('hidden');
          }
        }, 200);
      }
    });

    // Subtly alter ambient glow tone per channel
    if (ambientGlow) {
      if (index === 1) {
        // Reddit orange/rose
        ambientGlow.className = 'absolute -inset-1.5 bg-gradient-to-r from-orange-500/20 via-rose-500/20 to-amber-500/20 rounded-3xl blur-2xl opacity-60 -z-10 transition-all duration-700 pointer-events-none';
      } else if (index === 2) {
        // AI purple
        ambientGlow.className = 'absolute -inset-1.5 bg-gradient-to-r from-violet-600/20 via-purple-600/20 to-indigo-600/20 rounded-3xl blur-2xl opacity-60 -z-10 transition-all duration-700 pointer-events-none';
      } else if (index === 3) {
        // Perplexity teal
        ambientGlow.className = 'absolute -inset-1.5 bg-gradient-to-r from-teal-500/20 via-emerald-500/20 to-cyan-500/20 rounded-3xl blur-2xl opacity-60 -z-10 transition-all duration-700 pointer-events-none';
      } else {
        // Default blue/indigo
        ambientGlow.className = 'absolute -inset-1.5 bg-gradient-to-r from-blue-600/20 via-indigo-600/20 to-violet-600/20 rounded-3xl blur-2xl opacity-60 -z-10 transition-all duration-700 pointer-events-none';
      }
    }
  }

  // Allow manual clicking on tabs
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const channel = parseInt(tab.getAttribute('data-channel') || '0', 10);
      switchView(channel);
      isPausedByUser = true;
      // Resume auto-rotation after 8 seconds of inactivity
      setTimeout(() => {
        isPausedByUser = false;
      }, 8000);
    });
  });

  // Smooth headline rotation loop
  function rotateHeadline() {
    if (isPausedByUser || !headlineEl) return;

    // Check if user prefers reduced motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      currentIndex = (currentIndex + 1) % phrases.length;
      headlineEl.textContent = phrases[currentIndex].text;
      switchView(phrases[currentIndex].channelIndex);
      return;
    }

    // Step 1: Smooth blur & slide out
    headlineEl.style.filter = 'blur(8px)';
    headlineEl.style.opacity = '0';
    headlineEl.style.transform = 'translateY(-6px)';

    setTimeout(() => {
      // Step 2: Swap text & switch visual panel
      currentIndex = (currentIndex + 1) % phrases.length;
      headlineEl.textContent = phrases[currentIndex].text;
      switchView(phrases[currentIndex].channelIndex);

      // Step 3: Position below and sharpen into focus
      headlineEl.style.transform = 'translateY(6px)';
      
      setTimeout(() => {
        headlineEl.style.filter = 'blur(0px)';
        headlineEl.style.opacity = '1';
        headlineEl.style.transform = 'translateY(0px)';
      }, 50);

    }, 400);
  }

  // Start auto-rotation every 2.6 seconds
  setInterval(rotateHeadline, 2600);

  // Quick preset chips event handlers
  const presetChips = document.querySelectorAll<HTMLButtonElement>('.hero-preset-chip');
  const urlInput = document.getElementById('hero-url-input') as HTMLInputElement | null;
  const auditForm = document.getElementById('hero-audit-form');

  presetChips.forEach(chip => {
    chip.addEventListener('click', () => {
      const url = chip.getAttribute('data-url');
      if (url && urlInput) {
        urlInput.value = url;
        urlInput.focus();
      }
    });
  });

  if (auditForm) {
    auditForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const demoSection = document.getElementById('demo');
      if (demoSection) {
        demoSection.scrollIntoView({ behavior: 'smooth' });
        // Also trigger simulated crawl in simulator
        const simInput = document.getElementById('sim-domain-input') as HTMLInputElement | null;
        if (simInput && urlInput && urlInput.value) {
          simInput.value = urlInput.value;
        }
        const runBtn = document.getElementById('sim-run-btn');
        if (runBtn) {
          setTimeout(() => runBtn.click(), 400);
        }
      }
    });
  }
</script>

---
// src/components/Hero.astro
import HeroProductVisual from './HeroProductVisual.astro';
---

<section class="relative px-4 pt-6 pb-12 sm:px-6 sm:pt-10 sm:pb-16 lg:px-8 lg:pt-12 lg:pb-20" id="hero-section">
  
  <!-- Dark Hero Surface -->
  <div class="hero-surface relative max-w-7xl mx-auto rounded-[2rem] sm:rounded-[2.5rem] overflow-hidden bg-[#0a0e1a] shadow-2xl shadow-[#0a0e1a]/50">
    
    <!-- Ambient Glow Effects -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="absolute -top-32 -left-32 w-[500px] h-[500px] bg-blue-600/15 rounded-full blur-[120px]"></div>
      <div class="absolute -bottom-32 -right-32 w-[500px] h-[500px] bg-violet-600/15 rounded-full blur-[120px]"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-indigo-600/8 rounded-full blur-[100px]"></div>
    </div>

    <!-- Interactive Dot Canvas -->
    <canvas id="hero-dot-canvas" class="absolute inset-0 w-full h-full pointer-events-auto"></canvas>

    <!-- Hero Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-14 sm:py-20 lg:py-24 text-center">
      
      <!-- Eyebrow Pill -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/8 border border-white/10 text-xs font-semibold text-white/70 mb-8 hover:bg-white/12 transition-colors">
        <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
        <span class="tracking-wide">SEO · AI VISIBILITY · REDDIT OPPORTUNITIES</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight text-white max-w-5xl mx-auto leading-[1.12] sm:leading-[1.1]">
        <span>Be the answer your customers find</span>
        <span class="inline-flex items-center justify-center min-w-[180px] sm:min-w-[220px] md:min-w-[280px] lg:min-w-[340px] align-bottom mx-1">
          <span 
            id="hero-dynamic-text" 
            class="inline-block transition-all duration-500"
            style="filter: blur(0px); opacity: 1; transform: translateY(0);"
          >
            <!-- Platform content injected by JS -->
          </span>
        </span>
        <span>everywhere.</span>
      </h1>

      <!-- Subheading -->
      <p class="mt-6 sm:mt-8 text-lg sm:text-xl text-white/60 max-w-3xl mx-auto leading-relaxed">
        The lightweight visibility intelligence platform for small businesses, founders, and creators. Fix technical roadblocks, discover high-intent search queries, tap into active Reddit discussions, and get cited by AI answer engines.
      </p>

      <!-- Interactive URL Audit Bar & CTAs -->
      <div class="mt-8 sm:mt-10 max-w-2xl mx-auto">
        
        <form id="hero-audit-form" class="flex flex-col sm:flex-row items-center gap-2 p-2 bg-white/95 backdrop-blur-sm rounded-2xl border border-white/20 shadow-lg shadow-black/20 focus-within:border-blue-400 focus-within:ring-4 focus-within:ring-blue-500/20 transition-all">
          <div class="flex items-center gap-2.5 w-full px-3 py-1.5">
            <svg class="w-5 h-5 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0 3-4.03 3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
            </svg>
            <input 
              type="text" 
              id="hero-url-input"
              name="website" 
              placeholder="Enter your website (e.g. yourbrand.com)" 
              class="w-full text-sm sm:text-base text-slate-900 placeholder:text-slate-400 bg-transparent border-0 focus:outline-none focus:ring-0 font-medium"
              required
            />
          </div>
          
          <button 
            type="submit" 
            id="hero-submit-btn"
            class="w-full sm:w-auto shrink-0 inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-blue-600 hover:bg-blue-700 text-white text-sm sm:text-base font-semibold rounded-xl shadow-md shadow-blue-600/25 hover:shadow-lg hover:shadow-blue-600/35 transition-all duration-200 cursor-pointer"
          >
            <span>Analyze my website</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </form>

        <!-- Preset Example Chips -->
        <div class="mt-3 flex flex-wrap items-center justify-center gap-2 text-xs text-white/50">
          <span class="font-medium text-white/40">Try demo presets:</span>
          <button type="button" class="hero-preset-chip px-2.5 py-1 rounded-md bg-white/8 hover:bg-white/15 hover:text-white/90 border border-white/10 font-mono transition-colors cursor-pointer" data-url="resumeforge.io">
            resumeforge.io
          </button>
          <button type="button" class="hero-preset-chip px-2.5 py-1 rounded-md bg-white/8 hover:bg-white/15 hover:text-white/90 border border-white/10 font-mono transition-colors cursor-pointer" data-url="notion.so">
            notion.so
          </button>
          <button type="button" class="hero-preset-chip px-2.5 py-1 rounded-md bg-white/8 hover:bg-white/15 hover:text-white/90 border border-white/10 font-mono transition-colors cursor-pointer" data-url="cal.com">
            cal.com
          </button>
        </div>

        <!-- Value Props Row -->
        <div class="mt-6 flex flex-wrap items-center justify-center gap-4 sm:gap-8 text-xs sm:text-sm font-medium text-white/50">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
            <span>No credit card required</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
            <span>Instant 30-second audit</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
            <span>5 connected modules</span>
          </div>
        </div>

      </div>

      <!-- Product Visualization Component -->
      <HeroProductVisual />

    </div>
  </div>
</section>

<style>
  /* Platform wordmark styles */
  .platform-wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .platform-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5em;
    height: 1.5em;
    border-radius: 0.25em;
    flex-shrink: 0;
  }

  /* Google colors */
  .platform-google { color: #ffffff; }
  .platform-google .g-blue { color: #4285F4; }
  .platform-google .g-red { color: #EA4335; }
  .platform-google .g-yellow { color: #FBBC05; }
  .platform-google .g-green { color: #34A853; }

  /* Reddit */
  .platform-reddit { color: #FF4500; }
  .platform-reddit .reddit-icon {
    background: #FF4500;
    color: white;
    font-size: 0.65em;
  }

  /* ChatGPT */
  .platform-chatgpt { color: #ffffff; }
  .platform-chatgpt .chatgpt-icon {
    background: #10a37f;
    color: white;
  }

  /* Perplexity */
  .platform-perplexity { color: #20B8CD; }
  .platform-perplexity .perplexity-icon {
    background: #20B8CD;
    color: white;
  }

  /* Claude */
  .platform-claude { color: #D97757; }
  .platform-claude .claude-icon {
    background: #D97757;
    color: white;
  }

  /* Gemini */
  .platform-gemini { color: #ffffff; }
  .platform-gemini .gemini-icon {
    background: linear-gradient(135deg, #1a73e8, #9b72cb, #d96542);
    color: white;
  }
</style>

<script>
  // Platform data with brand-appropriate rendering
  const platforms = [
    { 
      id: 'google',
      render: () => `<span class="platform-wordmark platform-google"><span class="platform-icon rounded-md"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg></span><span class="g-blue">G</span><span class="g-red">o</span><span class="g-yellow">o</span><span class="g-blue">g</span><span class="g-green">l</span><span class="g-red">e</span></span>`,
      channelIndex: 0
    },
    { 
      id: 'reddit',
      render: () => `<span class="platform-wordmark platform-reddit"><span class="platform-icon reddit-icon rounded-full"><svg viewBox="0 0 24 24" width="0.85em" height="0.85em" fill="currentColor"><path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/></svg></span><span>Reddit</span></span>`,
      channelIndex: 1
    },
    { 
      id: 'chatgpt',
      render: () => `<span class="platform-wordmark platform-chatgpt"><span class="platform-icon chatgpt-icon rounded-md"><svg viewBox="0 0 24 24" width="0.85em" height="0.85em" fill="currentColor"><path d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.985 5.985 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.676l5.815 3.355-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.872zm16.597 3.855-5.833-3.387L15.119 7.2a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.407-.667zm2.01-3.023-.141-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135-2.02-1.164a.08.08 0 0 1-.038-.057V6.075a4.5 4.5 0 0 1 7.375-3.453l-.142.08L8.704 5.46a.795.795 0 0 0-.393.681zm1.097-2.365 2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5z"/></svg></span><span>ChatGPT</span></span>`,
      channelIndex: 2
    },
    { 
      id: 'perplexity',
      render: () => `<span class="platform-wordmark platform-perplexity"><span class="platform-icon perplexity-icon rounded-md"><svg viewBox="0 0 24 24" width="0.85em" height="0.85em" fill="currentColor"><path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm0 18c-4.411 0-8-3.589-8-8s3.589-8 8-8 8 3.589 8 8-3.589 8-8 8zm-2-11h4v2h-4v4H8v-4H6V9h2V7h2v2z"/></svg></span><span>Perplexity</span></span>`,
      channelIndex: 3
    },
    { 
      id: 'claude',
      render: () => `<span class="platform-wordmark platform-claude"><span class="platform-icon claude-icon rounded-md"><svg viewBox="0 0 24 24" width="0.85em" height="0.85em" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15h-2v-6h2v6zm4 0h-2v-8h2v8zm-2-10c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z"/></svg></span><span>Claude</span></span>`,
      channelIndex: 4
    },
    { 
      id: 'gemini',
      render: () => `<span class="platform-wordmark platform-gemini"><span class="platform-icon gemini-icon rounded-md"><svg viewBox="0 0 24 24" width="0.85em" height="0.85em" fill="currentColor"><path d="M12 2L2 12l10 10 10-10L12 2zm0 3.8L18.2 12 12 18.2 5.8 12 12 5.8z"/></svg></span><span>Gemini</span></span>`,
      channelIndex: 5
    }
  ];

  let currentIndex = 0;
  let isPausedByUser = false;
  const headlineEl = document.getElementById('hero-dynamic-text');
  const tabs = document.querySelectorAll<HTMLButtonElement>('.hero-tab-btn');
  const panels = document.querySelectorAll<HTMLElement>('.hero-view-panel');
  const ambientGlow = document.getElementById('visual-ambient-glow');

  function switchView(index: number) {
    // Update Tab UI
    tabs.forEach((tab, i) => {
      const isSelected = i === index;
      tab.setAttribute('aria-selected', isSelected.toString());
      if (isSelected) {
        tab.className = 'hero-tab-btn px-2.5 sm:px-3 py-1.5 rounded-lg transition-all duration-200 text-white bg-slate-600 shadow-xs font-medium cursor-pointer';
      } else {
        tab.className = 'hero-tab-btn px-2.5 sm:px-3 py-1.5 rounded-lg transition-all duration-200 text-slate-300 hover:text-white font-medium cursor-pointer';
      }
    });

    // Update Panels
    panels.forEach((panel, i) => {
      if (i === index) {
        panel.classList.remove('hidden');
        setTimeout(() => {
          panel.classList.remove('opacity-0');
          panel.classList.add('opacity-100');
        }, 30);
      } else {
        panel.classList.remove('opacity-100');
        panel.classList.add('opacity-0');
        setTimeout(() => {
          if (panel.classList.contains('opacity-0')) {
            panel.classList.add('hidden');
          }
        }, 200);
      }
    });

    // Subtly alter ambient glow tone per channel
    if (ambientGlow) {
      if (index === 1) {
        ambientGlow.className = 'absolute -inset-1.5 bg-gradient-to-r from-orange-500/20 via-rose-500/20 to-amber-500/20 rounded-3xl blur-2xl opacity-60 -z-10 transition-all duration-700 pointer-events-none';
      } else if (index === 2) {
        ambientGlow.className = 'absolute -inset-1.5 bg-gradient-to-r from-violet-600/20 via-purple-600/20 to-indigo-600/20 rounded-3xl blur-2xl opacity-60 -z-10 transition-all duration-700 pointer-events-none';
      } else if (index === 3) {
        ambientGlow.className = 'absolute -inset-1.5 bg-gradient-to-r from-teal-500/20 via-emerald-500/20 to-cyan-500/20 rounded-3xl blur-2xl opacity-60 -z-10 transition-all duration-700 pointer-events-none';
      } else {
        ambientGlow.className = 'absolute -inset-1.5 bg-gradient-to-r from-blue-600/20 via-indigo-600/20 to-violet-600/20 rounded-3xl blur-2xl opacity-60 -z-10 transition-all duration-700 pointer-events-none';
      }
    }
  }

  // Allow manual clicking on tabs
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const channel = parseInt(tab.getAttribute('data-channel') || '0', 10);
      switchView(channel);
      isPausedByUser = true;
      setTimeout(() => {
        isPausedByUser = false;
      }, 8000);
    });
  });

  // Smooth headline rotation loop
  function rotateHeadline() {
    if (isPausedByUser || !headlineEl) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      currentIndex = (currentIndex + 1) % platforms.length;
      headlineEl.innerHTML = platforms[currentIndex].render();
      switchView(platforms[currentIndex].channelIndex);
      return;
    }

    // Blur & fade out
    headlineEl.style.filter = 'blur(8px)';
    headlineEl.style.opacity = '0';
    headlineEl.style.transform = 'translateY(-4px)';

    setTimeout(() => {
      currentIndex = (currentIndex + 1) % platforms.length;
      headlineEl.innerHTML = platforms[currentIndex].render();
      switchView(platforms[currentIndex].channelIndex);

      // Position below and sharpen
      headlineEl.style.transform = 'translateY(4px)';
      
      setTimeout(() => {
        headlineEl.style.filter = 'blur(0px)';
        headlineEl.style.opacity = '1';
        headlineEl.style.transform = 'translateY(0px)';
      }, 50);

    }, 400);
  }

  // Initialize first platform
  if (headlineEl) {
    headlineEl.innerHTML = platforms[0].render();
  }

  // Start auto-rotation every 2.6 seconds
  setInterval(rotateHeadline, 2600);

  // Quick preset chips event handlers
  const presetChips = document.querySelectorAll<HTMLButtonElement>('.hero-preset-chip');
  const urlInput = document.getElementById('hero-url-input') as HTMLInputElement | null;
  const auditForm = document.getElementById('hero-audit-form');

  presetChips.forEach(chip => {
    chip.addEventListener('click', () => {
      const url = chip.getAttribute('data-url');
      if (url && urlInput) {
        urlInput.value = url;
        urlInput.focus();
      }
    });
  });

  if (auditForm) {
    auditForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const demoSection = document.getElementById('demo');
      if (demoSection) {
        demoSection.scrollIntoView({ behavior: 'smooth' });
        const simInput = document.getElementById('sim-domain-input') as HTMLInputElement | null;
        if (simInput && urlInput && urlInput.value) {
          simInput.value = urlInput.value;
        }
        const runBtn = document.getElementById('sim-run-btn');
        if (runBtn) {
          setTimeout(() => runBtn.click(), 400);
        }
      }
    });
  }

  // Interactive Dot Background
  const canvas = document.getElementById('hero-dot-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let mouse = { x: -1000, y: -1000 };
      let animationId: number;

      const dotSpacing = 28;
      const dotRadius = 1.2;
      const glowRadius = 80;
      const glowStrength = 0.4;

      function resizeCanvas() {
        const rect = canvas.parentElement!.getBoundingClientRect();
        canvas.width = rect.width;
        canvas.height = rect.height;
      }

      function drawDots() {
        if (!ctx) return;
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        const cols = Math.ceil(canvas.width / dotSpacing) + 1;
        const rows = Math.ceil(canvas.height / dotSpacing) + 1;

        for (let i = 0; i < cols; i++) {
          for (let j = 0; j < rows; j++) {
            const x = i * dotSpacing;
            const y = j * dotSpacing;

            const dx = mouse.x - x;
            const dy = mouse.y - y;
            const dist = Math.sqrt(dx * dx + dy * dy);

            let alpha = 0.15;
            if (dist < glowRadius) {
              const factor = 1 - (dist / glowRadius);
              alpha = 0.15 + (factor * glowStrength);
            }

            ctx.beginPath();
            ctx.arc(x, y, dotRadius, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;
            ctx.fill();
          }
        }

        if (!prefersReducedMotion) {
          animationId = requestAnimationFrame(drawDots);
        }
      }

      canvas.addEventListener('mousemove', (e) => {
        const rect = canvas.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
      });

      canvas.addEventListener('mouseleave', () => {
        mouse.x = -1000;
        mouse.y = -1000;
      });

      resizeCanvas();
      drawDots();

      window.addEventListener('resize', () => {
        resizeCanvas();
        if (prefersReducedMotion) drawDots();
      });
    }
  }
</script>

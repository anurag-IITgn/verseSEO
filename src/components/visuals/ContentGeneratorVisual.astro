---
// ContentGeneratorVisual.astro
---

<div class="w-full bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 shadow-xl shadow-slate-900/5 overflow-hidden" id="content-generator-widget">
  
  <!-- Header Bar -->
  <div class="bg-slate-50 border-b border-slate-200/80 px-5 py-3.5 flex flex-wrap items-center justify-between gap-2">
    <div class="flex items-center gap-2">
      <div class="w-3 h-3 rounded-full bg-indigo-600"></div>
      <span class="text-xs font-bold uppercase tracking-wider text-slate-700">Opportunity → Content Pipeline</span>
    </div>
    
    <!-- Tab Switcher -->
    <div class="flex items-center gap-1 bg-slate-200/70 p-1 rounded-lg text-xs font-semibold" id="content-view-tabs">
      <button type="button" class="content-tab-btn active px-2.5 py-1 rounded bg-white text-slate-900 shadow-2xs cursor-pointer" data-view="pipeline">
        Pipeline Flow
      </button>
      <button type="button" class="content-tab-btn px-2.5 py-1 rounded text-slate-600 hover:text-slate-900 cursor-pointer" data-view="brief">
        SEO Brief
      </button>
      <button type="button" class="content-tab-btn px-2.5 py-1 rounded text-slate-600 hover:text-slate-900 cursor-pointer" data-view="article">
        Article Draft
      </button>
    </div>
  </div>

  <div class="p-5 sm:p-6" id="content-views-container">
    
    <!-- VIEW 1: STEP-BY-STEP PIPELINE -->
    <div class="content-view-pane block space-y-4" data-pane="pipeline">
      
      <!-- Stage 1: Opportunity -->
      <div class="p-3.5 rounded-xl border border-slate-200 bg-slate-50 flex items-center justify-between">
        <div class="space-y-0.5">
          <span class="text-[10px] font-bold uppercase tracking-wider text-blue-600 font-mono">1. Discovered Search Opportunity</span>
          <h4 class="text-xs sm:text-sm font-bold text-slate-900">"How to make a resume with no experience"</h4>
        </div>
        <span class="px-2 py-0.5 rounded bg-blue-100 text-blue-800 text-[11px] font-bold font-mono">
          Vol: 12.4k
        </span>
      </div>

      <!-- Connector Arrow -->
      <div class="flex justify-center -my-2 text-slate-300">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>
      </div>

      <!-- Stage 2: Generated Brief -->
      <div class="p-3.5 rounded-xl border border-indigo-200 bg-indigo-50/30 space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-700 font-mono">2. AI-Structured Content Brief</span>
          <span class="text-xs text-indigo-600 font-semibold font-mono">1,650 Words • 8 Semantic Terms</span>
        </div>
        <div class="grid grid-cols-2 gap-2 text-xs">
          <div class="bg-white p-2 rounded-lg border border-slate-200/80">
            <span class="text-[10px] text-slate-400 block font-mono">PRIMARY ENTITY</span>
            <span class="font-semibold text-slate-800">Student Resume Formats</span>
          </div>
          <div class="bg-white p-2 rounded-lg border border-slate-200/80">
            <span class="text-[10px] text-slate-400 block font-mono">SEARCH INTENT</span>
            <span class="font-semibold text-slate-800">Educational / Actionable</span>
          </div>
        </div>
      </div>

      <!-- Connector Arrow -->
      <div class="flex justify-center -my-2 text-slate-300">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" /></svg>
      </div>

      <!-- Stage 3: Generated Article Preview -->
      <div class="p-3.5 rounded-xl border border-emerald-200 bg-white shadow-2xs space-y-1.5">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-700 font-mono">3. Output Article Draft Preview</span>
          <span class="text-[11px] font-semibold text-slate-400 font-mono">Markdown Ready</span>
        </div>
        <div class="bg-slate-50 p-3 rounded-lg border border-slate-100 font-mono text-xs text-slate-700 space-y-1">
          <div class="text-blue-700 font-bold"># How to Make a Resume With No Experience</div>
          <p class="text-slate-600 text-[11px] leading-relaxed">
            Starting your first resume can feel intimidating when you have no formal job history. The secret is formatting around relevant coursework, self-directed projects, and transferable skills...
          </p>
        </div>
      </div>

    </div>

    <!-- VIEW 2: FULL SEO BRIEF -->
    <div class="content-view-pane hidden space-y-3" data-pane="brief">
      <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-3 text-xs">
        <div class="border-b border-slate-200 pb-2">
          <div class="text-[10px] uppercase font-bold text-slate-400 font-mono">Brief Title</div>
          <div class="text-sm font-bold text-slate-900">How to Write a Resume With Zero Job Experience</div>
        </div>
        <div>
          <div class="text-[10px] uppercase font-bold text-slate-400 font-mono mb-1">Recommended Outline</div>
          <ul class="space-y-1 text-slate-700 font-mono text-[11px] list-disc list-inside">
            <li>H2: Why functional resumes beat chronological formats for students</li>
            <li>H2: Top 5 non-job experiences to highlight (projects, clubs, volunteering)</li>
            <li>H2: Action verbs and ATS keyword optimization</li>
            <li>H2: Free downloadable entry-level template</li>
          </ul>
        </div>
        <div>
          <div class="text-[10px] uppercase font-bold text-slate-400 font-mono mb-1">LSI Keywords to Include</div>
          <div class="flex flex-wrap gap-1.5">
            <span class="px-2 py-0.5 bg-white border border-slate-200 rounded text-[11px] text-slate-700 font-mono">entry level skills</span>
            <span class="px-2 py-0.5 bg-white border border-slate-200 rounded text-[11px] text-slate-700 font-mono">ATS friendly template</span>
            <span class="px-2 py-0.5 bg-white border border-slate-200 rounded text-[11px] text-slate-700 font-mono">coursework section</span>
          </div>
        </div>
      </div>
    </div>

    <!-- VIEW 3: ARTICLE DRAFT (FULL VIEW) -->
    <div class="content-view-pane hidden space-y-3" data-pane="article">
      <div class="bg-white p-4 rounded-xl border border-slate-200 space-y-3 text-xs text-slate-700 leading-relaxed font-sans">
        <h3 class="text-base font-extrabold text-slate-900 border-b border-slate-100 pb-2">
          How to Make a Resume With No Experience (The 2026 Student Guide)
        </h3>
        <p>
          Starting your first resume can feel intimidating when you look at a blank page. The most common mistake first-time job seekers make is assuming that only paid 9-to-5 roles count as experience.
        </p>
        <h4 class="font-bold text-slate-900 text-xs uppercase tracking-wider text-blue-600">
          1. Leverage the Functional Resume Layout
        </h4>
        <p>
          Unlike traditional chronological resumes which place work history at the top, a functional resume prioritizes your relevant skills, academic achievements, and leadership in student organizations.
        </p>
      </div>
    </div>

  </div>

  <!-- Footer Action -->
  <div class="bg-slate-50 border-t border-slate-200 px-5 py-3 flex items-center justify-between text-xs">
    <span class="text-slate-500 font-medium">Export ready for WordPress, Ghost, or Markdown</span>
    <button 
      type="button" 
      class="font-bold text-indigo-600 hover:text-indigo-800 transition-colors cursor-pointer"
      onclick="alert('Export functionality will be enabled when connecting to your publishing targets!')"
    >
      Copy Markdown Brief →
    </button>
  </div>

</div>

<script>
  const contentTabs = document.querySelectorAll<HTMLButtonElement>('#content-view-tabs .content-tab-btn');
  const contentPanes = document.querySelectorAll<HTMLElement>('#content-views-container .content-view-pane');

  contentTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      contentTabs.forEach(t => {
        t.classList.remove('bg-white', 'text-slate-900', 'shadow-2xs');
        t.classList.add('text-slate-600');
      });
      tab.classList.remove('text-slate-600');
      tab.classList.add('bg-white', 'text-slate-900', 'shadow-2xs');

      const view = tab.getAttribute('data-view');
      contentPanes.forEach(pane => {
        if (pane.getAttribute('data-pane') === view) {
          pane.classList.remove('hidden');
          pane.classList.add('block');
        } else {
          pane.classList.remove('block');
          pane.classList.add('hidden');
        }
      });
    });
  });
</script>

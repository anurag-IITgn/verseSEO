---
// AiVisibilityVisual.astro
---

<div class="w-full bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 shadow-xl shadow-slate-900/5 overflow-hidden" id="ai-visibility-widget">
  
  <!-- Header Bar -->
  <div class="bg-slate-50 border-b border-slate-200/80 px-5 py-3.5 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="w-3 h-3 rounded-full bg-violet-600 animate-pulse"></span>
      <span class="text-xs font-bold uppercase tracking-wider text-slate-700">AI & LLM Answer Engine Footprint</span>
    </div>
    <span class="text-[11px] font-semibold text-violet-700 bg-violet-50 px-2.5 py-1 rounded-md border border-violet-200">
      4 Major LLMs Monitored
    </span>
  </div>

  <div class="p-[1.15rem] space-y-3">
    
    <!-- Question Tracker Header Card -->
    <div class="bg-slate-50 border border-slate-200 rounded-lg p-2.5">
      <div class="text-[9px] font-bold uppercase tracking-wider text-slate-400 font-mono mb-0.5">Evaluated Prompt</div>
      <div class="text-[11px] sm:text-xs font-bold text-slate-900">
        "Best AI resume builders for students with no experience?"
      </div>
    </div>

    <!-- AI Engines Breakdown List -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
      
      <!-- ChatGPT -->
      <div class="p-2 rounded-lg border border-emerald-200 bg-emerald-50/40 flex items-center justify-between shadow-2xs">
        <div class="flex items-center gap-2">
          <img src="/brand/chatgpt-icon.svg" alt="ChatGPT icon" class="w-6 h-6 rounded" />
          <div>
            <div class="text-[10px] font-bold text-slate-900">ChatGPT (GPT-4o)</div>
            <div class="text-[9px] text-slate-500">Cited in #2 slot</div>
          </div>
        </div>
        <span class="text-[9px] font-bold text-emerald-700 bg-emerald-100/80 px-1.5 py-0.5 rounded">
          ✓ Mentioned
        </span>
      </div>

      <!-- Perplexity -->
      <div class="p-2 rounded-lg border border-emerald-200 bg-emerald-50/40 flex items-center justify-between shadow-2xs">
        <div class="flex items-center gap-2">
          <img src="/brand/perplexitynew.svg" alt="Perplexity icon" class="w-6 h-6 rounded" />
          <div>
            <div class="text-[10px] font-bold text-slate-900">Perplexity AI</div>
            <div class="text-[9px] text-slate-500">Direct source link</div>
          </div>
        </div>
        <span class="text-[9px] font-bold text-emerald-700 bg-emerald-100/80 px-1.5 py-0.5 rounded">
          ✓ Mentioned
        </span>
      </div>

      <!-- Claude -->
      <div class="p-2 rounded-lg border border-emerald-200 bg-emerald-50/40 flex items-center justify-between shadow-2xs">
        <div class="flex items-center gap-2">
          <img src="/brand/claude-ai-icon.svg" alt="Claude icon" class="w-6 h-6 rounded" />
          <div>
            <div class="text-[10px] font-bold text-slate-900">Claude 3.5</div>
            <div class="text-[9px] text-slate-500">Highlighted UX</div>
          </div>
        </div>
        <span class="text-[9px] font-bold text-emerald-700 bg-emerald-100/80 px-1.5 py-0.5 rounded">
          ✓ Mentioned
        </span>
      </div>

      <!-- Gemini -->
      <div class="p-2 rounded-lg border border-rose-200 bg-rose-50/40 flex items-center justify-between shadow-2xs">
        <div class="flex items-center gap-2">
          <img src="/brand/google-gemini-icon.svg" alt="Gemini icon" class="w-6 h-6 rounded" />
          <div>
            <div class="text-[10px] font-bold text-slate-900">Gemini</div>
            <div class="text-[9px] text-slate-500">Competitor cited</div>
          </div>
        </div>
        <span class="text-[9px] font-bold text-rose-700 bg-rose-100 px-1.5 py-0.5 rounded">
          ✕ Not Found
        </span>
      </div>

    </div>

    <!-- AI Visibility Overall Score Bar -->
    <div class="bg-gradient-to-r from-violet-50 to-indigo-50/70 border border-violet-200/80 rounded-lg p-3">
      <div class="flex items-center justify-between mb-1.5">
        <span class="text-[10px] font-bold text-violet-950 uppercase tracking-wide">Visibility Score</span>
        <span class="text-lg sm:text-xl font-black text-violet-800">64 / 100</span>
      </div>
      <div class="w-full bg-violet-200/80 rounded-full h-2 mb-1.5 overflow-hidden">
        <div class="bg-gradient-to-r from-violet-600 to-indigo-600 h-2 rounded-full" style="width: 64%"></div>
      </div>
      <div class="flex items-center justify-between text-[10px] text-slate-600">
        <span>Competitors in <strong>7/10</strong> prompts</span>
        <span class="font-bold text-violet-700">+21% gain</span>
      </div>
    </div>

    <!-- Recommendations Footer -->
    <div class="text-[10px] text-slate-500 flex items-center justify-between">
      <span>Add schema FAQ to unlock Gemini</span>
      <span class="text-violet-700 font-semibold">Track 50 prompts →</span>
    </div>

  </div>
</div>

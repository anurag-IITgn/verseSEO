---
// AiVisibilityVisual.astro
---

<div class="w-full bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 shadow-xl shadow-slate-900/5 overflow-hidden" id="ai-visibility-widget">
  
  <!-- Header Bar -->
  <div class="bg-slate-50 border-b border-slate-200/80 px-5 py-3.5 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="w-3 h-3 rounded-full bg-violet-600 animate-pulse"></span>
      <span class="text-xs font-bold uppercase tracking-wider text-slate-700">AI & LLM Answer Engine Footprint</span>
    </div>
    <span class="text-[11px] font-semibold text-violet-700 bg-violet-50 px-2.5 py-1 rounded-md border border-violet-200">
      4 Major LLMs Monitored
    </span>
  </div>

  <div class="p-5 sm:p-6 space-y-5">
    
    <!-- Question Tracker Header Card -->
    <div class="bg-slate-50 border border-slate-200 rounded-xl p-3.5">
      <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 font-mono mb-1">Evaluated Question Prompt</div>
      <div class="text-xs sm:text-sm font-bold text-slate-900">
        "What are the best AI resume builders for students with no prior work experience?"
      </div>
    </div>

    <!-- AI Engines Breakdown List -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      
      <!-- ChatGPT -->
      <div class="p-3 rounded-xl border border-emerald-200 bg-emerald-50/40 flex items-center justify-between shadow-2xs">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-emerald-700 text-white flex items-center justify-center font-black text-xs">
            GPT
          </div>
          <div>
            <div class="text-xs font-bold text-slate-900">ChatGPT (GPT-4o)</div>
            <div class="text-[11px] text-slate-500">Cited in #2 recommendation slot</div>
          </div>
        </div>
        <span class="text-xs font-bold text-emerald-700 bg-emerald-100/80 px-2 py-0.5 rounded">
          ✓ Mentioned
        </span>
      </div>

      <!-- Perplexity -->
      <div class="p-3 rounded-xl border border-emerald-200 bg-emerald-50/40 flex items-center justify-between shadow-2xs">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-teal-700 text-white flex items-center justify-center font-black text-xs">
            PRX
          </div>
          <div>
            <div class="text-xs font-bold text-slate-900">Perplexity AI</div>
            <div class="text-[11px] text-slate-500">Direct source link cited [1]</div>
          </div>
        </div>
        <span class="text-xs font-bold text-emerald-700 bg-emerald-100/80 px-2 py-0.5 rounded">
          ✓ Mentioned
        </span>
      </div>

      <!-- Claude -->
      <div class="p-3 rounded-xl border border-emerald-200 bg-emerald-50/40 flex items-center justify-between shadow-2xs">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-violet-700 text-white flex items-center justify-center font-black text-xs">
            CL
          </div>
          <div>
            <div class="text-xs font-bold text-slate-900">Claude 3.5 Sonnet</div>
            <div class="text-[11px] text-slate-500">Highlighted for beginner UX</div>
          </div>
        </div>
        <span class="text-xs font-bold text-emerald-700 bg-emerald-100/80 px-2 py-0.5 rounded">
          ✓ Mentioned
        </span>
      </div>

      <!-- Gemini -->
      <div class="p-3 rounded-xl border border-rose-200 bg-rose-50/40 flex items-center justify-between shadow-2xs">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center font-black text-xs">
            GEM
          </div>
          <div>
            <div class="text-xs font-bold text-slate-900">Google Gemini</div>
            <div class="text-[11px] text-slate-500">Competitor (Canva) cited instead</div>
          </div>
        </div>
        <span class="text-xs font-bold text-rose-700 bg-rose-100 px-2 py-0.5 rounded">
          ✕ Not Mentioned
        </span>
      </div>

    </div>

    <!-- AI Visibility Overall Score Bar -->
    <div class="bg-gradient-to-r from-violet-50 to-indigo-50/70 border border-violet-200/80 rounded-xl p-4">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-bold text-violet-950 uppercase tracking-wide">AI Engine Visibility Score</span>
        <span class="text-xl sm:text-2xl font-black text-violet-800">64 / 100</span>
      </div>
      <div class="w-full bg-violet-200/80 rounded-full h-2.5 mb-2 overflow-hidden">
        <div class="bg-gradient-to-r from-violet-600 to-indigo-600 h-2.5 rounded-full" style="width: 64%"></div>
      </div>
      <div class="flex items-center justify-between text-xs text-slate-600">
        <span>Competitors appeared in <strong>7 / 10</strong> relevant prompt scenarios.</span>
        <span class="font-bold text-violet-700">+21% potential gain</span>
      </div>
    </div>

    <!-- Recommendations Footer -->
    <div class="text-xs text-slate-500 flex items-center justify-between pt-1">
      <span>Publishing structured schema FAQ will unlock Gemini answers</span>
      <span class="text-violet-700 font-semibold">Track 50 custom prompts →</span>
    </div>

  </div>
</div>

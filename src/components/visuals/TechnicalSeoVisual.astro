---
// TechnicalSeoVisual.astro
---

<div class="w-full bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 shadow-xl shadow-slate-900/5 overflow-hidden" id="tech-seo-widget">
  
  <!-- Header Bar -->
  <div class="bg-slate-50 border-b border-slate-200/80 px-4 py-2.5 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <div class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></div>
      <span class="text-[10px] font-bold uppercase tracking-wider text-slate-600">Technical Health Audit</span>
    </div>
    <span class="text-[10px] font-mono font-medium text-slate-500 bg-white px-2 py-0.5 rounded-md border border-slate-200">
      Crawl Speed: 1.2s
    </span>
  </div>

  <div class="py-[0.5625rem] px-2.5 space-y-2">
    
    <!-- Health Score Row -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 p-2 rounded-xl bg-gradient-to-r from-emerald-50/70 via-teal-50/40 to-slate-50 border border-emerald-200/60">
      <div>
        <span class="text-[9px] font-bold uppercase tracking-wider text-emerald-800">Overall Health Score</span>
        <div class="text-xl sm:text-2xl font-extrabold text-slate-900 flex items-baseline gap-2 mt-0.5">
          <span id="tech-score-counter" class="text-emerald-700">82</span>
          <span class="text-xs font-semibold text-slate-400">/ 100</span>
          <span class="text-[9px] font-semibold px-1.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 ml-1">Good</span>
        </div>
      </div>

      <!-- Radial or Bar Progress Visual -->
      <div class="w-full sm:w-28">
        <div class="flex justify-between text-[9px] font-semibold text-slate-600 mb-0.5">
          <span>Indexability</span>
          <span class="text-emerald-700">82%</span>
        </div>
        <div class="w-full bg-slate-200 rounded-full h-1.5 overflow-hidden">
          <div class="bg-gradient-to-r from-emerald-500 to-teal-600 h-1.5 rounded-full transition-all duration-1000" style="width: 82%"></div>
        </div>
      </div>
    </div>

    <!-- Interactive Filter Tabs -->
    <div class="flex items-center gap-1 border-b border-slate-100 pb-1.5 text-[9px] font-semibold" id="tech-audit-tabs">
      <button type="button" class="tech-filter-btn active px-2 py-0.5 rounded-md bg-slate-900 text-white cursor-pointer" data-filter="all">
        All (5)
      </button>
      <button type="button" class="tech-filter-btn px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 hover:text-slate-900 cursor-pointer" data-filter="passed">
        Passed (3)
      </button>
      <button type="button" class="tech-filter-btn px-2 py-0.5 rounded-md bg-amber-50 text-amber-700 border border-amber-200/60 cursor-pointer" data-filter="warnings">
        Warnings (2)
      </button>
    </div>

    <!-- Audit Item Checklist with Interactive Tooltips -->
    <div class="space-y-1" id="tech-audit-list">
      
      <!-- Item 1: HTTPS -->
      <div class="tech-audit-row group p-1.5 rounded-lg border border-slate-200 hover:border-emerald-300 hover:bg-emerald-50/30 transition-all cursor-pointer" data-status="passed">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            <span class="w-4 h-4 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-[9px] shrink-0">✓</span>
            <div>
              <div class="text-[10px] font-bold text-slate-900">HTTPS & SSL Security</div>
              <div class="text-[9px] text-slate-500 font-mono">TLS 1.3 • Valid through Nov 2026</div>
            </div>
          </div>
          <span class="text-[9px] font-semibold text-emerald-700 bg-emerald-50 px-1 py-0.5 rounded border border-emerald-100">Pass</span>
        </div>
      </div>

      <!-- Item 2: XML Sitemap -->
      <div class="tech-audit-row group p-1.5 rounded-lg border border-slate-200 hover:border-emerald-300 hover:bg-emerald-50/30 transition-all cursor-pointer" data-status="passed">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            <span class="w-4 h-4 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-[9px] shrink-0">✓</span>
            <div>
              <div class="text-[10px] font-bold text-slate-900">XML Sitemap & robots.txt</div>
              <div class="text-[9px] text-slate-500 font-mono">142 valid pages submitted</div>
            </div>
          </div>
          <span class="text-[9px] font-semibold text-emerald-700 bg-emerald-50 px-1 py-0.5 rounded border border-emerald-100">Pass</span>
        </div>
      </div>

      <!-- Item 3: Canonical Tag -->
      <div class="tech-audit-row group p-1.5 rounded-lg border border-slate-200 hover:border-emerald-300 hover:bg-emerald-50/30 transition-all cursor-pointer" data-status="passed">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            <span class="w-4 h-4 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-[9px] shrink-0">✓</span>
            <div>
              <div class="text-[10px] font-bold text-slate-900">Canonical URL</div>
              <div class="text-[9px] text-slate-500 font-mono">100% of landing URLs configured</div>
            </div>
          </div>
          <span class="text-[9px] font-semibold text-emerald-700 bg-emerald-50 px-1 py-0.5 rounded border border-emerald-100">Pass</span>
        </div>
      </div>

      <!-- Item 4: Meta Description Warning -->
      <div class="tech-audit-row group p-1.5 rounded-lg border border-amber-200 bg-amber-50/40 hover:bg-amber-50/80 transition-all cursor-pointer" data-status="warnings">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            <span class="w-4 h-4 rounded-full bg-amber-200 text-amber-900 flex items-center justify-center font-bold text-[9px] shrink-0">⚠</span>
            <div>
              <div class="text-[10px] font-bold text-slate-900">Meta Description Missing</div>
              <div class="text-[9px] text-amber-800 font-mono">3 high-traffic URLs empty</div>
            </div>
          </div>
          <span class="text-[9px] font-semibold text-amber-800 bg-amber-100 px-1 py-0.5 rounded border border-amber-200">Warning</span>
        </div>
      </div>

      <!-- Item 5: Broken Links Warning -->
      <div class="tech-audit-row group p-1.5 rounded-lg border border-amber-200 bg-amber-50/40 hover:bg-amber-50/80 transition-all cursor-pointer" data-status="warnings">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            <span class="w-4 h-4 rounded-full bg-amber-200 text-amber-900 flex items-center justify-center font-bold text-[9px] shrink-0">⚠</span>
            <div>
              <div class="text-[10px] font-bold text-slate-900">4 Broken Internal Links</div>
              <div class="text-[9px] text-amber-800 font-mono">404 on /docs/v1-guide</div>
            </div>
          </div>
          <span class="text-[9px] font-semibold text-amber-800 bg-amber-100 px-1 py-0.5 rounded border border-amber-200">Warning</span>
        </div>
      </div>

    </div>

    <!-- Bottom Action Prompt -->
    <div class="bg-slate-50 rounded-lg p-1.5 text-[9px] text-slate-500 flex items-center justify-between">
      <span>Hover for fix instructions</span>
      <span class="text-blue-600 font-semibold">1-Click Export →</span>
    </div>

  </div>
</div>

<script>
  const techTabs = document.querySelectorAll<HTMLButtonElement>('#tech-audit-tabs .tech-filter-btn');
  const auditRows = document.querySelectorAll<HTMLElement>('#tech-audit-list .tech-audit-row');

  techTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      techTabs.forEach(t => {
        t.classList.remove('bg-slate-900', 'text-white');
        t.classList.add('bg-slate-100', 'text-slate-600');
      });
      tab.classList.remove('bg-slate-100', 'text-slate-600');
      tab.classList.add('bg-slate-900', 'text-white');

      const filter = tab.getAttribute('data-filter');
      auditRows.forEach(row => {
        const status = row.getAttribute('data-status');
        if (filter === 'all' || status === filter) {
          row.style.display = 'block';
        } else {
          row.style.display = 'none';
        }
      });
    });
  });
</script>

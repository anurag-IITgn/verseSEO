---
// FeatureSection.astro
interface Props {
  moduleNumber: string;
  moduleName: string;
  eyebrowBadge: string;
  badgeTheme?: 'blue' | 'emerald' | 'orange' | 'violet' | 'indigo';
  headline: string;
  description: string;
  bullets: Array<{ title: string; desc: string }>;
  layout?: 'text-left' | 'text-right';
  id?: string;
}

const {
  moduleNumber,
  moduleName,
  eyebrowBadge,
  badgeTheme = 'blue',
  headline,
  description,
  bullets,
  layout = 'text-left',
  id
} = Astro.props;

const badgeStyles = {
  blue: 'bg-blue-50 text-blue-700 border-blue-200/80',
  emerald: 'bg-emerald-50 text-emerald-700 border-emerald-200/80',
  orange: 'bg-orange-50 text-orange-700 border-orange-200/80',
  violet: 'bg-violet-50 text-violet-700 border-violet-200/80',
  indigo: 'bg-indigo-50 text-indigo-700 border-indigo-200/80'
}[badgeTheme];

const bulletIconStyles = {
  blue: 'text-blue-600 bg-blue-50',
  emerald: 'text-emerald-600 bg-emerald-50',
  orange: 'text-orange-600 bg-orange-50',
  violet: 'text-violet-600 bg-violet-50',
  indigo: 'text-indigo-600 bg-indigo-50'
}[badgeTheme];
---

<div class="py-16 sm:py-24 border-b border-slate-200/70 relative" id={id}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class={`grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center ${layout === 'text-right' ? 'lg:flex-row-reverse' : ''}`}>
      
      <!-- Text Description Column -->
      <div class={`lg:col-span-5 space-y-6 ${layout === 'text-right' ? 'lg:order-2' : 'lg:order-1'}`}>
        
        <div class="space-y-3">
          <div class={`inline-flex items-center gap-2 px-3 py-1 rounded-full border text-xs font-bold uppercase tracking-wider ${badgeStyles}`}>
            <span>{eyebrowBadge}</span>
          </div>

          <h3 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
            {headline}
          </h3>

          <p class="text-base text-slate-600 leading-relaxed">
            {description}
          </p>
        </div>

        <!-- Feature Points -->
        <div class="space-y-4 pt-2">
          {bullets.map((bullet) => (
            <div class="flex items-start gap-3">
              <div class={`w-5 h-5 rounded-lg flex items-center justify-center font-bold text-xs shrink-0 mt-0.5 ${bulletIconStyles}`}>
                ✓
              </div>
              <div>
                <strong class="text-sm font-bold text-slate-900 block">{bullet.title}</strong>
                <span class="text-xs sm:text-sm text-slate-600 leading-normal">{bullet.desc}</span>
              </div>
            </div>
          ))}
        </div>

        <!-- Micro Interactive Trigger -->
        <div class="pt-2">
          <a 
            href="#demo" 
            class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-slate-900 hover:text-blue-600 transition-colors group"
          >
            <span>Simulate {moduleName} in Live Demo</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

      </div>

      <!-- Visual Product Component Column -->
      <div class={`lg:col-span-7 ${layout === 'text-right' ? 'lg:order-1' : 'lg:order-2'}`}>
        <slot />
      </div>

    </div>

  </div>
</div>

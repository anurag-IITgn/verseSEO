---
// FAQ.astro
const faqs = [
  {
    question: "What is VerseSEO?",
    answer: "VerseSEO is a lightweight visibility intelligence platform designed for small businesses, founders, and creators. Instead of overwhelming reports, VerseSEO unifies technical website health, high-intent Google search gaps, active Reddit discussions, and AI answer engine citations into a clear, actionable dashboard."
  },
  {
    question: "What does VerseSEO analyze?",
    answer: "VerseSEO scans five core visibility areas: technical crawl health (SSL, sitemaps, canonicals), high-intent Google search opportunities, relevant Reddit community discussions, AI engine citation footprints (ChatGPT, Perplexity, Claude, Gemini), and content structure gaps."
  },
  {
    question: "How can VerseSEO help improve my website's search visibility?",
    answer: "VerseSEO identifies specific technical roadblocks that prevent search engines from indexing your site, highlights low-competition search queries your target audience uses, and suggests content structures that help your pages rank higher in organic search results."
  },
  {
    question: "What are Search Opportunities?",
    answer: "Search Opportunities are high-intent, low-difficulty search queries where potential buyers actively look for solutions like yours. VerseSEO highlights these keyword gaps so you can create targeted content that captures organic traffic."
  },
  {
    question: "How does VerseSEO help with technical SEO?",
    answer: "VerseSEO crawls your website to detect technical issues like missing sitemaps, broken internal links, unoptimized metadata, SSL flaws, and canonical errors. It provides simple, step-by-step guidance to fix each issue without complex jargon."
  },
  {
    question: "How does VerseSEO help with Reddit visibility?",
    answer: "VerseSEO monitors relevant Reddit threads where users ask questions related to your industry. It alerts you to authentic discussion opportunities so you can participate directly with genuine, helpful advice or create website content addressing those questions."
  },
  {
    question: "How does VerseSEO measure AI visibility?",
    answer: "VerseSEO tracks whether major AI models cite or recommend your brand when answering user prompts. It calculates an AI Citation Score and highlights which published sources or content structures feed those AI recommendations."
  },
  {
    question: "Why does AI search visibility matter for the future of SEO?",
    answer: "As more people turn to AI engines like ChatGPT, Gemini, Claude, and Perplexity to research products and get recommendations, being visible in generative answers is becoming an important part of online discovery. VerseSEO helps you understand whether AI engines mention or cite your brand, where competitors are winning visibility, and what you can improve to increase your chances of being included in relevant AI-generated answers."
  },
  {
    question: "Which AI answer engines does VerseSEO track?",
    answer: "VerseSEO monitors brand citations and product recommendations across top AI search models, including ChatGPT (OpenAI), Perplexity AI, Claude (Anthropic), and Google Gemini."
  },
  {
    question: "Can VerseSEO help me find content opportunities?",
    answer: "Yes. VerseSEO analyzes user intent and discussion trends across search and social channels, generating structured content briefs with suggested headings, semantic topics, and target questions to help you write high-performing content."
  },
  {
    question: "Who is VerseSEO designed for?",
    answer: "VerseSEO is built specifically for solo founders, small business operators, creators, and lean marketing teams who need actionable visibility insights without expensive agency retainers or overly complex enterprise software."
  },
  {
    question: "Does VerseSEO automatically post content or Reddit replies for me?",
    answer: "No. VerseSEO functions strictly as an intelligence and discovery platform. We provide research, alerts, and content recommendations, but you retain full control over posting content or replying to community discussions."
  },
  {
    question: "How does the VerseSEO demo scan work?",
    answer: "The interactive demo scan runs an instant analysis on sample domain personas (or your website URL) in under 30 seconds, generating an initial health score, sample keyword gaps, and AI citation benchmarks."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section class="py-16 sm:py-24 bg-[#FAF9F5] border-b border-slate-200/80 relative" id="faq">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-bold uppercase tracking-wider mb-3">
        Frequently Asked Questions
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Everything you need to know.
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
        Clear answers about our methodology, data privacy, and how we measure visibility across modern search.
      </p>
    </div>

    <!-- Accordion List -->
    <div class="space-y-4" id="faq-accordion-container">
      {faqs.map((faq, index) => (
        <div class="faq-item rounded-2xl border border-slate-200/90 bg-white/60 hover:bg-white transition-all overflow-hidden">
          <button 
            type="button" 
            class="faq-toggle-btn w-full p-5 sm:p-6 text-left flex items-center justify-between gap-4 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 cursor-pointer"
            aria-expanded="false"
            aria-controls={`faq-answer-${index}`}
            id={`faq-btn-${index}`}
          >
            <span class="text-base sm:text-lg font-bold text-slate-900 leading-snug">
              {faq.question}
            </span>
            <span class="faq-chevron w-7 h-7 rounded-full bg-white border border-slate-200 flex items-center justify-center text-slate-500 shrink-0 transition-transform duration-200">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </button>
          
          <div 
            id={`faq-answer-${index}`} 
            role="region" 
            aria-labelledby={`faq-btn-${index}`} 
            class="faq-content hidden px-5 sm:px-6 pb-5 sm:pb-6 text-sm sm:text-base text-slate-600 leading-relaxed border-t border-slate-200/40 pt-4"
          >
            {faq.answer}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const faqButtons = document.querySelectorAll<HTMLButtonElement>('.faq-toggle-btn');

  faqButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      const content = btn.nextElementSibling as HTMLElement | null;
      const chevron = btn.querySelector('.faq-chevron') as HTMLElement | null;

      // Close all other FAQs for clean single-view accordion
      faqButtons.forEach(otherBtn => {
        if (otherBtn !== btn) {
          otherBtn.setAttribute('aria-expanded', 'false');
          const otherContent = otherBtn.nextElementSibling as HTMLElement | null;
          const otherChevron = otherBtn.querySelector('.faq-chevron') as HTMLElement | null;
          if (otherContent) otherContent.classList.add('hidden');
          if (otherChevron) otherChevron.classList.remove('rotate-180', 'bg-blue-600', 'text-white', 'border-blue-600');
        }
      });

      // Toggle current
      btn.setAttribute('aria-expanded', (!isExpanded).toString());
      if (content) {
        if (isExpanded) {
          content.classList.add('hidden');
          if (chevron) {
            chevron.classList.remove('rotate-180', 'bg-blue-600', 'text-white', 'border-blue-600');
          }
        } else {
          content.classList.remove('hidden');
          if (chevron) {
            chevron.classList.add('rotate-180', 'bg-blue-600', 'text-white', 'border-blue-600');
          }
        }
      }
    });
  });
</script>

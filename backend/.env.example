# ─── Server ───
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# ─── PostgreSQL (development only) ───
# Used by backend/docker-compose.yml to configure the container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=seo_saas
POSTGRES_PORT=5432

# Connection string consumed by the backend itself.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/seo_saas

# ─── CORS / cookies ───
# Comma-separated list of allowed frontend origins. REQUIRED in production.
# Cookie credentials are only sent to origins listed here.
FRONTEND_ORIGIN=http://localhost:4321
# Set true when the backend runs behind a reverse proxy so request.ip reflects
# the real client IP (needed for IP-based rate limiting).
TRUST_PROXY=false
# COOKIE_SECURE defaults to true in production, false otherwise.
# COOKIE_SECURE=true
# SameSite policy. 'lax' works for same-site deployments (frontend + backend on
# the same registrable domain). Use 'none' (requires Secure) only if the frontend
# and backend are hosted on entirely different domains.
# COOKIE_SAME_SITE=lax

# ─── Crawler (development) ───
MAX_PAGES=50
CRAWL_TIMEOUT_MS=10000
CRAWL_USER_AGENT=VisibilityCrawler/1.0
# SSRF guard. Blocks crawling of localhost/private/internal network targets.
# Enable ONLY for local development against private-network websites.
# CRAWL_ALLOW_PRIVATE_NETWORKS=false

# ─── Rate limiting (lightweight, in-memory) ───
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_CREATE_MAX=60
# RATE_LIMIT_CRAWL_MAX=30
# RATE_LIMIT_ANALYZE_MAX=30
# RATE_LIMIT_WINDOW_MS=3600000

# ─── Reddit discovery (official Reddit API — optional) ───
# Free app credentials from https://www.reddit.com/prefs/apps (script/app type).
# When these are absent, Reddit discovery reports an honest "not connected"
# state instead of fabricating discussions.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=VerseSEOMicrotool/0.1 (SEO research tool)

# ─── AI Engine Footprint (official Google Gemini API — optional) ───
# Free API key from https://aistudio.google.com/apikey (Gemini API).
# When absent, AI visibility reports an honest "provider not connected"
# state instead of fabricating AI responses or citations.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash